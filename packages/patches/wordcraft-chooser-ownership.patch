+    fn finish_owned_pick(&mut self, owner: DialogOwner, after: AfterPick, picked: Option<String>) -> Result<Value, String> {
+        if !owner.matches(self, &after) {
+            // Do not even clear operation-local state: it may now belong to a newer intent.
+            if picked.is_none() {
+                return Ok(json!({"cancelled": true}));
+            }
+            let message = "The document changed while choosing a file. Please reopen the operation.";
+            self.status(message.to_string());
+            self.ui.backstage = false;
+            return Err(message.to_string());
+        }
+        let result = self.finish_pick(after, picked);
+        if result.is_err() {
+            self.ui.backstage = false;
+        }
+        result
     }
 
