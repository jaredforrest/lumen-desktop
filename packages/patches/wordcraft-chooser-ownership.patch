+
+/// The document and operation context that requested a native chooser.
+/// A late host answer must never act on whichever document is current later.
+struct DialogOwner {
+    document: u64,
+    revision: u64,
+    dirty: bool,
+    password: Option<wordcraft_engine::Password>,
+    path: Option<std::path::PathBuf>,
+    picture: Option<PictureOwner>,
+    recipients: Option<Value>,
+}
+
+#[derive(PartialEq)]
+struct PictureOwner {
+    selection: wordcraft_engine::Selection,
+    additional: Vec<wordcraft_doc::Pos>,
+    column: Option<wordcraft_engine::ColumnBlock>,
+    column_mode: bool,
+    pending: Option<wordcraft_doc::props::CharProps>,
+    target: Option<String>,
+}
+impl PictureOwner {
+    fn capture(app: &WordApp) -> Self {
+        Self {
+            selection: app.session.sel.clone(),
+            additional: app.session.also_selected.clone(),
+            column: app.session.column.clone(),
+            column_mode: app.session.column_mode,
+            pending: app.session.pending.clone(),
+            target: app.change_picture_target.clone(),
+        }
+    }
+}
+
+impl DialogOwner {
+    fn recipients(app: &WordApp) -> Value {
+        let m = &app.session.merge;
+        json!([m.kind, m.headers, m.rows, m.preview, m.record, m.highlight])
+    }
+
+    fn capture(app: &WordApp, after: &AfterPick) -> Self {
+        Self {
+            document: app.session.document_id(),
+            revision: app.session.rev(),
+            dirty: app.session.dirty,
+            password: app.session.password.clone(),
+            path: app.session.path.clone(),
+            picture: matches!(after, AfterPick::Picture).then(|| PictureOwner::capture(app)),
+            recipients: matches!(after, AfterPick::Recipients).then(|| Self::recipients(app)),
+        }
+    }
+
+    fn matches(&self, app: &WordApp, after: &AfterPick) -> bool {
+        self.document == app.session.document_id()
+            && self.revision == app.session.rev()
+            && self.dirty == app.session.dirty
+            && self.password == app.session.password
+            && self.path == app.session.path
+            && self.picture.as_ref().is_none_or(|state| state == &PictureOwner::capture(app))
+            && self.recipients.as_ref().is_none_or(|state| state == &Self::recipients(app))
+            && match after {
+                AfterPick::SaveAs(AfterSave::Continue { document, .. }) => *document == self.document,
+                _ => true,
+            }
+    }
 }
 
