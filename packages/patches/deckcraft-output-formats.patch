@@ -0,0 +1,76 @@
+//! Truthful output routing; an unimplemented format never becomes a native container.
+use std::path::Path;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Format { Native, Presentation, Pdf, Outline, Png, Jpeg }
+impl Format {
+    pub(crate) fn name(self) -> &'static str {
+        match self { Self::Native => "deckcraft", Self::Presentation => "pptx", Self::Pdf => "pdf", Self::Outline => "outline", Self::Png => "png", Self::Jpeg => "jpeg" }
+    }
+}
+
+pub(crate) fn parse(value: &str) -> Result<Format, String> {
+    match value.to_ascii_lowercase().as_str() {
+        "deckcraft" | "slidecraft" => Ok(Format::Native),
+        "pptx" | "potx" | "ppsx" => Ok(Format::Presentation),
+        "pdf" => Ok(Format::Pdf),
+        "outline" | "txt" | "md" => Ok(Format::Outline),
+        "png" => Ok(Format::Png),
+        "jpeg" | "jpg" => Ok(Format::Jpeg),
+        _ => Err(format!("Output format '{value}' is unsupported")),
+    }
+}
+
+pub(crate) fn infer(path: &str) -> Result<Format, String> {
+    let extension = Path::new(path).extension().and_then(|v| v.to_str()).unwrap_or("");
+    if extension.is_empty() { return Ok(Format::Native); }
+    // These filename extensions are the provider's declared native and export families.
+    match extension.to_ascii_lowercase().as_str() {
+        "deckcraft" | "slidecraft" | "pptx" | "potx" | "ppsx" | "pdf" | "txt" | "md" | "png" | "jpeg" | "jpg" => parse(extension),
+        _ => Err(format!("Output filename extension '.{extension}' is unsupported")),
+    }
+}
+
+pub(crate) fn checked(path: &str, explicit: Option<&str>) -> Result<Format, String> {
+    let inferred = infer(path)?;
+    let Some(explicit) = explicit else { return Ok(inferred) };
+    let requested = parse(explicit)?;
+    let has_extension = Path::new(path).extension().is_some_and(|v| !v.is_empty());
+    if has_extension && inferred != requested {
+        return Err("The filename extension does not match the selected output format".into());
+    }
+    Ok(requested)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn declared_aliases_and_case_keep_their_real_output_family() {
+        for (suffix, expected) in [("deckcraft",Format::Native),("slidecraft",Format::Native),("PPTX",Format::Presentation),("potx",Format::Presentation),("ppsx",Format::Presentation),("PDF",Format::Pdf),("md",Format::Outline),("txt",Format::Outline),("PNG",Format::Png),("jpg",Format::Jpeg),("jpeg",Format::Jpeg)] {
+            assert_eq!(infer(&format!("copy.{suffix}")).unwrap(),expected);
+            assert_eq!(checked(&format!("copy.{suffix}"),Some(expected.name())).unwrap(),expected);
+        }
+        assert_eq!(checked("copy.pptx",Some("PpTx")).unwrap(),Format::Presentation);
+    }
+    #[test]
+    fn extensionless_native_and_explicit_known_formats_remain_available() {
+        assert_eq!(infer("folder.with.dots/copy").unwrap(),Format::Native);
+        assert_eq!(checked("copy",Some("PDF")).unwrap(),Format::Pdf);
+        assert_eq!(parse("SLIDECRAFT").unwrap(),Format::Native);
+    }
+    #[test]
+    fn unsupported_suffix_cannot_be_disguised_with_an_explicit_native_format() {
+        for suffix in ["odp","ODP","otp","ppt","pptm","invented"] {
+            assert!(infer(&format!("copy.{suffix}")).is_err());
+            assert!(checked(&format!("copy.{suffix}"),Some("deckcraft")).is_err());
+        }
+        assert!(parse("odp").is_err()); assert!(parse("").is_err());
+    }
+    #[test]
+    fn conflicting_declared_families_are_refused() {
+        assert!(checked("copy.pdf",Some("pptx")).is_err());
+        assert!(checked("copy.pptx",Some("odp")).is_err());
+        assert!(checked("copy.png",Some("jpeg")).is_err());
+    }
+}
