+    #[test]
+    fn print_failure_exposes_the_existing_document_status() {
+        use egui_kittest::kittest::Queryable;
+        let mut a = typed();
+        a.services.print = Some(Box::new(|_| Err("Fixture viewer unavailable".into())));
+        a.run("file.print", json!({})).unwrap();
+        let mut h = egui_kittest::Harness::builder().with_size(egui::vec2(1440.0, 900.0)).build_ui_state(
+            |ui, app: &mut WordApp| {
+                let ctx = ui.ctx().clone();
+                app.logic(&ctx);
+                app.ui(ui);
+            }, a,
+        );
+        for _ in 0..4 { h.step(); }
+        h.get_by_role_and_label(egui::accesskit::Role::Button, "Print").click();
+        h.step(); h.step();
+        assert!(!h.state().ui.backstage, "the failed handoff must reveal the status bar");
+        assert!(h.state().status_msg.as_ref().is_some_and(|(text, _)| text.contains("Fixture viewer unavailable")));
+        assert!(h.state().session.dirty, "a failed print does not save the draft");
+    }
