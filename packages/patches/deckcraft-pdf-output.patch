+//! Captured provider document for export and the explicit PDF-print subset.
+use crate::{SlideApp, dialogs::Dialog};
+use std::path::{Path, PathBuf};
+
+pub(crate) fn render_pdf(doc: &deckcraft_model::Presentation, params: &serde_json::Value) -> Result<Vec<u8>, String> {
+    deckcraft_engine::cmd::file::pdf_bytes(doc, params).map_err(|error| error.to_string())
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct ExportSource {
+    uid: u64,
+    revision: u64,
+    path: Option<String>,
+    slide: usize,
+    canonical: Option<PathBuf>,
+    #[cfg(unix)]
+    file_identity: Option<(u64, u64)>,
+}
+impl ExportSource {
+    pub(crate) fn capture(app: &SlideApp) -> Option<Self> {
+        app.session.active().map(|d| Self {
+            uid: d.uid, revision: d.revision, path: d.path.clone(), slide: d.selection.slide,
+            canonical: d.path.as_deref().and_then(|p| Path::new(p).canonicalize().ok()),
+            #[cfg(unix)]
+            file_identity: d.path.as_deref().and_then(|p| std::fs::metadata(p).ok()).map(|m| { use std::os::unix::fs::MetadataExt; (m.dev(), m.ino()) }),
+        })
+    }
+    pub(crate) fn matches(&self, app: &SlideApp) -> bool {
+        app.session.active().is_some_and(|d| self.uid == d.uid && self.revision == d.revision && self.path == d.path && self.slide == d.selection.slide)
+    }
+    pub(crate) fn is_source_destination(&self, path: &str) -> bool {
+        if self.canonical.is_some() && self.canonical == Path::new(path).canonicalize().ok() { return true; }
+        #[cfg(unix)]
+        if self.file_identity.is_some() && self.file_identity == std::fs::metadata(path).ok().map(|m| { use std::os::unix::fs::MetadataExt; (m.dev(), m.ino()) }) { return true; }
+        false
+    }
+}
+impl SlideApp {
+    pub(crate) fn open_export_dialog(&mut self, printing: bool) -> Result<(), String> {
+        if printing && self.services.pick_save.is_none() && self.services.download.is_none() { return Err("PDF output is unavailable: no destination picker or download provider is configured".into()); }
+        let source = ExportSource::capture(self).ok_or("No presentation is available to export")?;
+        let mut dialog = Dialog::new(if printing { "printPdf" } else { "export" });
+        dialog.source = Some(source);
+        self.dialog = Some(dialog);
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Services;
+    use deckcraft_engine::Session;
+    use serde_json::json;
+    fn app() -> SlideApp { SlideApp::new(Session::with_new(), Services { pick_save: Some(Box::new(|_| None)), ..Default::default() }) }
+    #[test]
+    fn pdf_output_dialog_is_captured_and_does_not_replace_regular_export() {
+        let mut a = app(); a.run("app.printPdfDialog", json!({})).unwrap();
+        assert_eq!(a.dialog.as_ref().unwrap().id, "printPdf"); assert!(a.dialog.as_ref().unwrap().source.as_ref().unwrap().matches(&a));
+        a.run("app.exportDialog", json!({})).unwrap(); assert_eq!(a.dialog.as_ref().unwrap().id, "export");
+    }
+    #[test]
+    fn pdf_output_replacement_revision_and_selection_invalidate_captured_dialog() {
+        let mut a = app(); let first = ExportSource::capture(&a).unwrap(); a.session.active_mut().unwrap().revision += 1; assert!(!first.matches(&a));
+        let second = ExportSource::capture(&a).unwrap(); a.session.active_mut().unwrap().selection.slide += 1; assert!(!second.matches(&a));
+        let third = ExportSource::capture(&a).unwrap(); a.session.active_mut().unwrap().path = Some("/captured/new-name.pptx".into()); assert!(!third.matches(&a));
+        let fourth = ExportSource::capture(&a).unwrap(); a.run("file.new", json!({"blank":true})).unwrap(); assert!(!fourth.matches(&a));
+    }
+    #[test]
+    fn pdf_output_empty_page_set_is_an_error_not_a_successful_empty_file() {
+        let mut a = app(); std::sync::Arc::make_mut(&mut a.session.active_mut().unwrap().doc).slides.clear();
+        let target = std::env::temp_dir().join(format!("deck-no-pages-{}.pdf", std::process::id())); std::fs::write(&target, b"Existing copy").unwrap();
+        let result = render_pdf(&a.session.active().unwrap().doc, &json!({})).and_then(|bytes| crate::pdf_publication::publish(&target, &bytes));
+        assert!(result.is_err()); assert_eq!(std::fs::read(&target).unwrap(), b"Existing copy"); std::fs::remove_file(target).unwrap();
+    }
+    #[test]
+    fn pdf_output_missing_provider_is_explicit() {
+        let mut a = SlideApp::new(Session::with_new(), Services::default());
+        assert!(a.run("app.printPdfDialog", json!({})).unwrap_err().contains("unavailable")); assert!(a.dialog.is_none());
+    }
+}
