+//! Exclusive PDF staging in the captured destination directory.
+use std::{fs::{File, OpenOptions}, io::Write, path::Path, sync::atomic::{AtomicU64, Ordering}};
+static NEXT: AtomicU64 = AtomicU64::new(0);
+pub(crate) fn publish(path: &Path, bytes: &[u8]) -> Result<(), String> { publish_with(path, bytes, || {}) }
+fn publish_with(path: &Path, bytes: &[u8], before_publish: impl FnOnce()) -> Result<(), String> {
+    let parent = path.parent().ok_or("PDF destination has no parent")?;
+    let canonical = parent.canonicalize().map_err(|e| e.to_string())?;
+    let directory = File::open(&canonical).map_err(|e| e.to_string())?;
+    let captured = directory.metadata().map_err(|e| e.to_string())?;
+    if !captured.is_dir() { return Err("PDF destination parent is not a directory".into()); }
+    #[cfg(target_os = "linux")]
+    let anchor = { use std::os::fd::AsRawFd; std::path::PathBuf::from(format!("/proc/self/fd/{}", directory.as_raw_fd())) };
+    #[cfg(not(target_os = "linux"))]
+    let anchor = canonical.clone();
+    let leaf = path.file_name().ok_or("PDF destination has no filename")?;
+    let (temporary, mut file) = (0..100).find_map(|_| {
+        let temporary = anchor.join(format!(".provider-pdf-{}-{}.tmp", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+        OpenOptions::new().write(true).create_new(true).open(&temporary).ok().map(|file| (temporary, file))
+    }).ok_or("Cannot create exclusive PDF output staging file")?;
+    let result = (|| {
+        file.write_all(bytes).map_err(|e| e.to_string())?; file.sync_all().map_err(|e| e.to_string())?;
+        before_publish();
+        let current = parent.canonicalize().and_then(std::fs::metadata).map_err(|e| e.to_string())?;
+        #[cfg(unix)]
+        { use std::os::unix::fs::MetadataExt; if (current.dev(), current.ino()) != (captured.dev(), captured.ino()) { return Err("PDF destination directory changed".into()); } }
+        #[cfg(not(unix))]
+        if parent.canonicalize().map_err(|e| e.to_string())? != canonical { return Err("PDF destination directory changed".into()); }
+        std::fs::rename(&temporary, anchor.join(leaf)).map_err(|e| e.to_string())
+    })();
+    drop(file); if result.is_err() { let _ = std::fs::remove_file(&temporary); } result
+}
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    #[test]
+    fn pdf_output_publication_never_writes_through_destination_or_predictable_temporary_alias() {
+        let root = std::env::temp_dir().join(format!("pdf-publish-alias-{}", std::process::id())); std::fs::create_dir_all(&root).unwrap();
+        let source = root.join("source.xlsx"); let target = root.join("copy.pdf"); std::fs::write(&source, b"Original").unwrap();
+        std::fs::hard_link(&source, root.join("copy.pdf.sctmp")).unwrap();
+        publish_with(&target, b"%PDF-copy", || { std::fs::hard_link(&source, &target).unwrap(); }).unwrap();
+        assert_eq!(std::fs::read(&source).unwrap(), b"Original"); assert_eq!(std::fs::read(&target).unwrap(), b"%PDF-copy"); std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn pdf_output_publication_rejects_retargeted_directory_and_cleans_owned_staging() {
+        use std::os::unix::fs::symlink;
+        let root = std::env::temp_dir().join(format!("pdf-publish-parent-{}", std::process::id())); std::fs::create_dir_all(root.join("one")).unwrap(); std::fs::create_dir_all(root.join("two")).unwrap();
+        let alias = root.join("selected"); symlink(root.join("one"), &alias).unwrap();
+        assert!(publish_with(&alias.join("copy.pdf"), b"%PDF-copy", || { std::fs::remove_file(&alias).unwrap(); symlink(root.join("two"), &alias).unwrap(); }).is_err());
+        assert_eq!(std::fs::read_dir(root.join("one")).unwrap().count(), 0); assert_eq!(std::fs::read_dir(root.join("two")).unwrap().count(), 0); std::fs::remove_dir_all(root).unwrap();
+    }
+}
