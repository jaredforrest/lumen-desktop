+#[cfg(test)]
+mod persistent_history_file_menu_tests {
+    use super::*;
+    use crate::Services;
+    use deckcraft_engine::Session;
+    use egui_kittest::kittest::Queryable;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+    struct Fixture(std::path::PathBuf);
+    impl Drop for Fixture { fn drop(&mut self) { std::fs::remove_dir_all(&self.0).unwrap(); } }
+    #[test]
+    fn persistent_history_actual_file_menu_opens_owned_dialog_without_replacing_ribbon_tab() {
+        for size in [vec2(1100.0, 900.0), vec2(700.0, 480.0)] {
+            let root = Fixture(std::env::temp_dir().join(format!("deck-file-history-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed))));
+            std::fs::create_dir(&root.0).unwrap();
+            let mut session = Session::with_new();
+            session.execute("file.saveAs", &json!({"path":root.0.join("source.deckcraft")})).unwrap();
+            let mut app = SlideApp::new(session, Services::default());
+            app.ui.tab = "Review".into();
+            let mut h = egui_kittest::Harness::builder().with_size(size).build_ui_state(|ui, app: &mut SlideApp| {
+                let ctx = ui.ctx().clone(); app.logic(&ctx); app.ui(ui);
+            }, app);
+            h.run_steps(4);
+            assert!(h.state().dialog.is_none());
+            h.get_by_label("File").click();
+            h.run_steps(4);
+            h.get_by_label("Version History…").click();
+            h.run_steps(4);
+            let dialog = h.state().dialog.as_ref().unwrap();
+            assert_eq!(dialog.id, "history");
+            assert!(dialog.history.is_some());
+            assert_eq!(h.state().ui.tab, "Review");
+            assert!(!h.state().ui.ribbon_collapsed);
+            let viewport = egui::Rect::from_min_size(egui::Pos2::ZERO, size);
+            assert!(viewport.contains_rect(h.get_by_label("Capture version").rect()));
+            h.get_by_label("Close").click();
+            h.run_steps(4);
+            assert!(h.state().dialog.is_none());
+            assert_eq!(h.state().ui.tab, "Review");
+        }
+    }
+    #[test]
+    fn persistent_history_file_catalogue_respects_document_command_enablement() {
+        let mut app = SlideApp::new(Session::with_new(), Services::default());
+        assert!(enabled(&app, "file.history"));
+        app.session.close_document(0);
+        assert!(!enabled(&app, "file.history"));
+        assert!(!enabled(&app, "file.save"));
+        assert!(enabled(&app, "file.new"));
+        assert!(crate::menus::menu_tree().into_iter().find(|(name, _)| *name == "File").unwrap().1.contains(&("Version History…", "file.history")));
+    }
+}
