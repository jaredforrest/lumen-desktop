+/// Visible File actions share the catalogue and command enablement with other frontends.
+fn file_menu(app: &mut SlideApp, ui: &mut Ui, rect: Rect) {
+    let response = ui.put(rect, egui::Button::new("File").frame(false));
+    egui::Popup::menu(&response).show(|ui| {
+        if let Some((_, commands)) = crate::menus::menu_tree().into_iter().find(|(name, _)| *name == "File") {
+            for (label, id) in commands {
+                if label == "-" { ui.separator(); continue; }
+                if ui.add_enabled(enabled(app, id), egui::Button::new(label)).clicked() {
+                    run(app, id, json!({}));
+                    ui.close();
+                }
+            }
+        }
+    });
+}
