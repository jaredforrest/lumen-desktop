+//! Provider-owned PDF destination selection; engine output remains unchanged.
+use crate::SheetApp;
+use gridcraft_engine::Selection;
+use serde_json::{Value, json};
+use std::path::Path;
+
+#[derive(Clone, Debug, PartialEq)]
+struct Source {
+    uid: u64,
+    revision: u64,
+    path: Option<String>,
+    sheet: usize,
+    selection: Selection,
+}
+impl Source {
+    fn capture(app: &SheetApp) -> Option<Self> {
+        app.session.active().map(|d| Self { uid: d.uid, revision: d.revision, path: d.path.clone(), sheet: d.wb.active_sheet, selection: d.selection.clone() })
+    }
+    fn matches(&self, app: &SheetApp) -> bool { Self::capture(app).as_ref() == Some(self) }
+}
+
+impl SheetApp {
+    pub(super) fn run_pdf_output(&mut self, id: &str, params: &Value) -> Option<Result<Value, String>> {
+        if !matches!(id, "file.print" | "file.exportPdf") || params.get("path").and_then(Value::as_str).is_some_and(|p| !p.is_empty()) { return None; }
+        if !params.is_object() || params.get("path").is_some_and(|path| !path.is_string() && !path.is_null()) { return Some(Err("PDF parameters must be an object with a text destination".into())); }
+        Some(self.pick_pdf_output(id, params))
+    }
+    fn pick_pdf_output(&mut self, id: &str, params: &Value) -> Result<Value, String> {
+        let source = Source::capture(self).ok_or("No workbook is available to print")?;
+        if let Some(pick) = &self.services.pick_pdf {
+            let document = self.session.active().ok_or("No workbook is available to print")?;
+            let original = document.path.clone();
+            let original_canonical = original.as_deref().and_then(|p| Path::new(p).canonicalize().ok());
+            #[cfg(unix)]
+            let original_identity = original.as_deref().and_then(|p| std::fs::metadata(p).ok()).map(|m| { use std::os::unix::fs::MetadataExt; (m.dev(), m.ino()) });
+            let suggested = Path::new(&document.display_title()).with_extension("pdf").to_string_lossy().to_string();
+            let Some(path) = pick(&suggested) else { return Ok(json!({"cancelled": true})); };
+            if !source.matches(self) { return Err("Workbook changed while choosing a PDF destination; reopen Print to PDF".into()); }
+            let destination = Path::new(&path);
+            if !destination.is_absolute() || !destination.extension().and_then(|s| s.to_str()).is_some_and(|s| s.eq_ignore_ascii_case("pdf")) { return Err("Choose an absolute PDF destination ending in .pdf".into()); }
+            if original_canonical.is_some() && original_canonical == destination.canonicalize().ok() { return Err("Print to PDF cannot replace the source workbook".into()); }
+            #[cfg(unix)]
+            if original_identity.is_some() && original_identity == std::fs::metadata(destination).ok().map(|m| { use std::os::unix::fs::MetadataExt; (m.dev(), m.ino()) }) { return Err("Print to PDF cannot replace the source workbook".into()); }
+            let mut parameters = params.clone();
+            parameters.as_object_mut().ok_or("PDF parameters must be an object")?.remove("path");
+            let mut result = self.session.run(id, parameters)?;
+            let bytes = gridcraft_engine::io::base64_decode(result["base64"].as_str().ok_or("PDF renderer returned no payload")?).ok_or("PDF renderer returned an invalid payload")?;
+            crate::pdf_publication::publish(destination, &bytes)?;
+            result["path"] = json!(path);
+            return Ok(result);
+        }
+        if self.services.download.is_some() {
+            let result = self.session.run(id, params.clone())?;
+            self.deliver_pdf(&result);
+            return Ok(result);
+        }
+        Err("PDF output is unavailable: no destination picker or download provider is configured".into())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Services;
+    use gridcraft_engine::Session;
+    fn app(services: Services) -> SheetApp { let mut session = Session::new(); session.new_workbook(); SheetApp::new(session, services) }
+    #[test]
+    fn pdf_output_missing_provider_is_explicit_and_cancel_preserves_document() {
+        let mut a = app(Services::default());
+        assert!(a.run("file.print", json!({})).unwrap_err().contains("unavailable"));
+        assert!(a.run("file.exportPdf", json!({})).unwrap_err().contains("unavailable"));
+        a.services.pick_pdf = Some(Box::new(|_| None));
+        let before = Source::capture(&a);
+        assert_eq!(a.run("file.print", json!({})).unwrap()["cancelled"], true);
+        assert_eq!(Source::capture(&a), before);
+    }
+    #[test]
+    fn pdf_output_shortcut_dispatches_once_and_malformed_parameters_do_not_pick() {
+        let calls = std::rc::Rc::new(std::cell::Cell::new(0)); let seen = calls.clone();
+        let mut a = app(Services { pick_pdf: Some(Box::new(move |_| { seen.set(seen.get()+1); None })), ..Default::default() });
+        crate::ribbon::shortcut(&mut a, egui::Key::P, egui::Modifiers::COMMAND); assert_eq!(calls.get(), 1);
+        assert!(a.run("file.print", json!([])).is_err()); assert!(a.run("file.print", json!({"path":42})).is_err()); assert_eq!(calls.get(), 1);
+    }
+    #[test]
+    fn pdf_output_source_replacement_revision_and_selection_are_not_retargeted() {
+        let mut a = app(Services::default()); let first = Source::capture(&a).unwrap();
+        a.run("cell.set", json!({"cell":"A1","input":"Changed"})).unwrap(); assert!(!first.matches(&a));
+        let second = Source::capture(&a).unwrap(); a.session.active_mut().unwrap().selection.active.col = 1; assert!(!second.matches(&a));
+        let third = Source::capture(&a).unwrap(); a.session.active_mut().unwrap().path = Some("/captured/new-name.xlsx".into()); assert!(!third.matches(&a));
+        let fourth = Source::capture(&a).unwrap(); a.session.new_workbook(); assert!(!fourth.matches(&a));
+    }
+    #[test]
+    fn pdf_output_picker_writes_pdf_without_saving_workbook_and_rejects_other_extension() {
+        let root = std::env::temp_dir().join(format!("grid-pdf-output-{}", std::process::id())); std::fs::create_dir_all(&root).unwrap();
+        let target = root.join("copy.pdf"); let selected = target.to_string_lossy().to_string();
+        let mut a = app(Services { pick_pdf: Some(Box::new(move |_| Some(selected.clone()))), ..Default::default() });
+        let before = Source::capture(&a); a.run("file.print", json!({})).unwrap();
+        assert!(std::fs::read(&target).unwrap().starts_with(b"%PDF")); assert_eq!(Source::capture(&a), before);
+        a.services.pick_pdf = Some(Box::new(|_| Some("/invalid/changed.xlsx".into()))); assert!(a.run("file.print", json!({})).is_err());
+        #[cfg(unix)]
+        {
+            let original = root.join("source.xlsx"); let alias = root.join("alias.pdf"); std::fs::write(&original, b"Original workbook").unwrap(); std::fs::hard_link(&original, &alias).unwrap();
+            a.session.active_mut().unwrap().path = Some(original.to_string_lossy().to_string()); let chosen = alias.to_string_lossy().to_string();
+            a.services.pick_pdf = Some(Box::new(move |_| Some(chosen.clone()))); assert!(a.run("file.print", json!({})).is_err()); assert_eq!(std::fs::read(&original).unwrap(), b"Original workbook");
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
