@@ -24,6 +27,46 @@ namespace qs::wayland::toplevel::wlr {
 
 QS_LOGGING_CATEGORY(logToplevelManagement, "quickshell.wayland.toplevelManagement", QtWarningMsg);
 
+IdentityManager::IdentityManager(): QWaylandClientExtensionTemplate(1) { this->initialize(); }
+IdentityManager* IdentityManager::instance() {
+	static auto* instance = new IdentityManager(); // NOLINT
+	return instance;
+}
+
+ToplevelHandle::ToplevelHandle() {
+	QObject::connect(IdentityManager::instance(), &QWaylandClientExtension::activeChanged,
+	    this, &ToplevelHandle::resolveIdentity);
+}
+
+QString ToplevelHandle::foreignToplevelIdentifier() const { return this->mForeignToplevelIdentifier; }
+
+void ToplevelHandle::resolveIdentity() {
+	const auto generation = ++this->identityGeneration;
+	delete this->identityReply.data();
+	this->identityReply = nullptr;
+	const bool changed = !this->mForeignToplevelIdentifier.isEmpty();
+	this->mForeignToplevelIdentifier.clear();
+	QPointer<ToplevelHandle> self(this);
+	if (changed) emit this->foreignToplevelIdentifierChanged();
+	if (!self || generation != this->identityGeneration || !this->isInitialized()
+	    || !this->isReady || !IdentityManager::instance()->isActive()) return;
+	auto* proxy = IdentityManager::instance()->resolve(this->object());
+	QPointer<ToplevelHandle> owner(this);
+	this->identityReply = new IdentityReply(this, this->identityGeneration, proxy,
+	    [owner](IdentityReply* reply, quint64 generation, const QString& identifier) {
+		    if (owner) owner->completeIdentity(reply, generation, identifier);
+	    });
+}
+
+void ToplevelHandle::completeIdentity(IdentityReply* reply, quint64 generation, const QString& identifier) {
+	if (this->identityReply != reply || generation != this->identityGeneration
+	    || !IdentityManager::instance()->isActive()) return;
+	this->identityReply = nullptr;
+	if (this->mForeignToplevelIdentifier == identifier) return;
+	this->mForeignToplevelIdentifier = identifier;
+	emit this->foreignToplevelIdentifierChanged();
+}
+
 ToplevelManager::ToplevelManager(): QWaylandClientExtensionTemplate(3) { this->initialize(); }
 
 bool ToplevelManager::available() const { return this->isActive(); }
@@ -168,12 +211,19 @@ void ToplevelHandle::zwlr_foreign_toplevel_handle_v1_done() {
 	this->isReady = true;
 
 	if (!wasReady) {
+		QPointer<ToplevelHandle> self(this);
+		this->resolveIdentity();
+		if (!self) return;
 		emit this->ready();
 	}
 }
 
 void ToplevelHandle::zwlr_foreign_toplevel_handle_v1_closed() {
 	qCDebug(logToplevelManagement) << this << "closed";
+	++this->identityGeneration;
+	delete this->identityReply.data();
+	this->identityReply = nullptr;
+	this->mForeignToplevelIdentifier.clear();
 	this->destroy();
 	emit this->closed();
 	delete this;
