+IdentityManager::IdentityManager(): QWaylandClientExtensionTemplate(1) { this->initialize(); }
+IdentityManager* IdentityManager::instance() {
+	static auto* instance = new IdentityManager(); // NOLINT
+	return instance;
+}
+
+// QtWayland's generated wrapper does not retire proxies for incoming destructor
+// events. Own the raw proxy explicitly, retiring it before any observable signal.
+class IdentityReply: public QObject, public QtWayland::lumen_toplevel_identity_reply_v1 {
+public:
+	IdentityReply(ToplevelHandle* owner, quint64 generation,
+	    ::lumen_toplevel_identity_reply_v1* proxy)
+	    : QObject(owner), owner(owner), generation(generation), proxy(proxy) { this->init(proxy); }
+	~IdentityReply() override { this->retire(); }
+private:
+	void retire() {
+		if (auto* proxy = std::exchange(this->proxy, nullptr)) {
+			wl_proxy_destroy(reinterpret_cast<wl_proxy*>(proxy));
+		}
+	}
+	void lumen_toplevel_identity_reply_v1_result(uint32_t status, const QString& identifier) override {
+		QPointer<IdentityReply> self(this);
+		auto owner = std::exchange(this->owner, nullptr);
+		const auto generation = this->generation;
+		this->retire();
+		if (owner) {
+			QObject::disconnect(owner, nullptr, this, nullptr);
+			// The compositor supplies the existing ext identifier: never accept a
+			// malformed identifier or invent one from a title, app key or proxy ID.
+			const bool valid = status == 1 && !identifier.isEmpty() && identifier.size() <= 32
+			    && std::all_of(identifier.cbegin(), identifier.cend(), [](QChar c) {
+				    return c.unicode() >= 0x21 && c.unicode() <= 0x7e;
+			    });
+			owner->completeIdentity(this, generation, valid ? identifier : QString());
+		}
+		// completeIdentity can synchronously destroy the owner and this child.
+		if (self) self->deleteLater();
+	}
+	QPointer<ToplevelHandle> owner;
+	quint64 generation;
+	::lumen_toplevel_identity_reply_v1* proxy;
+};
+
+ToplevelHandle::ToplevelHandle() {
+	QObject::connect(IdentityManager::instance(), &QWaylandClientExtension::activeChanged,
+	    this, &ToplevelHandle::resolveIdentity);
+}
+
+QString ToplevelHandle::foreignToplevelIdentifier() const { return this->mForeignToplevelIdentifier; }
+
+void ToplevelHandle::resolveIdentity() {
+	const auto generation = ++this->identityGeneration;
+	delete this->identityReply.data();
+	this->identityReply = nullptr;
+	const bool changed = !this->mForeignToplevelIdentifier.isEmpty();
+	this->mForeignToplevelIdentifier.clear();
+	QPointer<ToplevelHandle> self(this);
+	if (changed) emit this->foreignToplevelIdentifierChanged();
+	if (!self || generation != this->identityGeneration || !this->isInitialized()
+	    || !this->isReady || !IdentityManager::instance()->isActive()) return;
+	auto* proxy = IdentityManager::instance()->resolve(reinterpret_cast<wl_object*>(this->object()));
+	this->identityReply = new IdentityReply(this, this->identityGeneration, proxy);
+}
+
+void ToplevelHandle::completeIdentity(IdentityReply* reply, quint64 generation, const QString& identifier) {
+	if (this->identityReply != reply || generation != this->identityGeneration
+	    || !IdentityManager::instance()->isActive()) return;
+	this->identityReply = nullptr;
+	if (this->mForeignToplevelIdentifier == identifier) return;
+	this->mForeignToplevelIdentifier = identifier;
+	emit this->foreignToplevelIdentifierChanged();
+}
+
 ToplevelManager::ToplevelManager(): QWaylandClientExtensionTemplate(3) { this->initialize(); }
 
 bool ToplevelManager::available() const { return this->isActive(); }
