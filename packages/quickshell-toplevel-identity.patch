diff --git a/src/wayland/toplevel/identity_reply.hpp b/src/wayland/toplevel/identity_reply.hpp
new file mode 100644
index 0000000..667b265
--- /dev/null
+++ b/src/wayland/toplevel/identity_reply.hpp
@@ -0,0 +1,50 @@
+#pragma once
+#include <algorithm>
+#include <functional>
+#include <utility>
+#include <qobject.h>
+#include <qpointer.h>
+#include <wayland-client-core.h>
+#include "qwayland-lumen-toplevel-identity-v1.h"
+
+namespace qs::wayland::toplevel::wlr {
+// Generated QtWayland wrappers do not retire proxies on destructor events.
+// This helper owns exactly one raw proxy, independently of its QObject owner.
+class IdentityReply: public QObject, public QtWayland::lumen_toplevel_identity_reply_v1 {
+public:
+	using Complete = std::function<void(IdentityReply*, quint64, const QString&)>;
+	IdentityReply(QObject* owner, quint64 generation,
+	    ::lumen_toplevel_identity_reply_v1* proxy, Complete complete)
+	    : QObject(owner), owner(owner), generation(generation), proxy(proxy), complete(std::move(complete)) {
+		this->init(proxy);
+	}
+	~IdentityReply() override { this->retire(); }
+private:
+	void retire() {
+		if (auto* proxy = std::exchange(this->proxy, nullptr)) {
+			wl_proxy_destroy(reinterpret_cast<wl_proxy*>(proxy));
+		}
+	}
+	void lumen_toplevel_identity_reply_v1_result(uint32_t status, const QString& identifier) override {
+		QPointer<IdentityReply> self(this);
+		auto owner = std::exchange(this->owner, nullptr);
+		const auto generation = this->generation;
+		auto complete = std::move(this->complete);
+		this->retire();
+		if (owner) {
+			QObject::disconnect(owner, nullptr, this, nullptr);
+			const bool valid = status == 1 && !identifier.isEmpty() && identifier.size() <= 32
+			    && std::all_of(identifier.cbegin(), identifier.cend(), [](QChar c) {
+				    return c.unicode() >= 0x21 && c.unicode() <= 0x7e;
+			    });
+			complete(this, generation, valid ? identifier : QString());
+		}
+		// Completion may synchronously destroy the owner and this child.
+		if (self) self->deleteLater();
+	}
+	QPointer<QObject> owner;
+	quint64 generation;
+	::lumen_toplevel_identity_reply_v1* proxy;
+	Complete complete;
+};
+}
diff --git a/src/wayland/toplevel/identity_reply_test.cpp b/src/wayland/toplevel/identity_reply_test.cpp
new file mode 100644
index 0000000..bdd72b5
--- /dev/null
+++ b/src/wayland/toplevel/identity_reply_test.cpp
@@ -0,0 +1,170 @@
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <cstring>
+#include <stdexcept>
+#include <qcoreapplication.h>
+#include <qpointer.h>
+#include <qtest.h>
+#include <wayland-server-core.h>
+#include <wayland-client-core.h>
+#include "identity_reply.hpp"
+#include "wayland-wlr-foreign-toplevel-management-unstable-v1-client-protocol.h"
+#include "lumen-toplevel-identity-v1-server.h"
+#include "wlr-foreign-toplevel-management-unstable-v1-server.h"
+
+using qs::wayland::toplevel::wlr::IdentityReply;
+
+// A real disposable Wayland connection and generated wire protocol. The fake
+// provider deliberately delays and duplicates replies to stress client lifetime;
+// it does not claim to test Sway's separate resource membership implementation.
+class Wire {
+public:
+	Wire() {
+		int sockets[2];
+		ensure(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) == 0);
+		server = wl_display_create();
+		ensure(server);
+		ensure(wl_client_create(server, sockets[0]));
+		client = wl_display_connect_to_fd(sockets[1]);
+		ensure(client);
+		ensure(wl_global_create(server, &lumen_toplevel_identity_manager_v1_interface, 1, this, bindIdentity));
+		ensure(wl_global_create(server, &zwlr_foreign_toplevel_manager_v1_interface, 3, this, bindForeign));
+		registry = wl_display_get_registry(client);
+		static const wl_registry_listener listener = {global, removed};
+		wl_registry_add_listener(registry, &listener, this);
+		for (int i = 0; i < 8 && !handle; ++i) pump();
+		ensure(manager && handle);
+	}
+	~Wire() {
+		if (handle) wl_proxy_destroy(reinterpret_cast<wl_proxy*>(handle));
+		if (manager) wl_proxy_destroy(reinterpret_cast<wl_proxy*>(manager));
+		if (foreignManager) wl_proxy_destroy(reinterpret_cast<wl_proxy*>(foreignManager));
+		if (registry) wl_registry_destroy(registry);
+		if (client) wl_display_disconnect(client);
+		if (server) {
+			wl_display_destroy_clients(server);
+			wl_display_destroy(server);
+		}
+	}
+	IdentityReply* request(QObject* owner, quint64 generation, IdentityReply::Complete callback) {
+		auto* proxy = lumen_toplevel_identity_manager_v1_resolve(manager, handle);
+		auto* reply = new IdentityReply(owner, generation, proxy, std::move(callback));
+		pump();
+		ensure(pending);
+		return reply;
+	}
+	void result(uint32_t status, const char* identifier, bool twice = false) {
+		ensure(pending);
+		lumen_toplevel_identity_reply_v1_send_result(pending, status, identifier);
+		if (twice) lumen_toplevel_identity_reply_v1_send_result(pending, status, identifier);
+		wl_resource_destroy(pending);
+		pending = nullptr;
+		pump();
+		ensure(wl_display_get_error(client) == 0);
+	}
+	void pump() {
+		for (int i = 0; i < 4; ++i) {
+			ensure(wl_display_flush(client) >= 0);
+			ensure(wl_event_loop_dispatch(wl_display_get_event_loop(server), 0) >= 0);
+			wl_display_flush_clients(server);
+			pollfd fd{wl_display_get_fd(client), POLLIN, 0};
+			if (poll(&fd, 1, 0) > 0 && (fd.revents & POLLIN)) ensure(wl_display_dispatch(client) >= 0);
+			QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+		}
+	}
+private:
+	static void ensure(bool value) { if (!value) throw std::runtime_error("Disposable identity wire failed"); }
+	static void global(void* data, wl_registry* registry, uint32_t name, const char* interface, uint32_t) {
+		auto* wire = static_cast<Wire*>(data);
+		if (std::strcmp(interface, "lumen_toplevel_identity_manager_v1") == 0) {
+			wire->manager = static_cast<lumen_toplevel_identity_manager_v1*>(
+			    wl_registry_bind(registry, name, &lumen_toplevel_identity_manager_v1_interface, 1));
+		} else if (std::strcmp(interface, "zwlr_foreign_toplevel_manager_v1") == 0) {
+			wire->foreignManager = static_cast<zwlr_foreign_toplevel_manager_v1*>(
+			    wl_registry_bind(registry, name, &zwlr_foreign_toplevel_manager_v1_interface, 3));
+			static const zwlr_foreign_toplevel_manager_v1_listener listener = {toplevel, finished};
+			zwlr_foreign_toplevel_manager_v1_add_listener(wire->foreignManager, &listener, wire);
+		}
+	}
+	static void removed(void*, wl_registry*, uint32_t) {}
+	static void toplevel(void* data, zwlr_foreign_toplevel_manager_v1*, zwlr_foreign_toplevel_handle_v1* handle) {
+		static_cast<Wire*>(data)->handle = handle;
+	}
+	static void finished(void*, zwlr_foreign_toplevel_manager_v1*) {}
+	static void destroyManager(wl_client*, wl_resource* resource) { wl_resource_destroy(resource); }
+	static void resolve(wl_client* client, wl_resource* manager, uint32_t id, wl_resource* handle) {
+		auto* wire = static_cast<Wire*>(wl_resource_get_user_data(manager));
+		ensure(handle == wire->foreignResource && !wire->pending);
+		wire->pending = wl_resource_create(client, &lumen_toplevel_identity_reply_v1_interface, 1, id);
+		ensure(wire->pending);
+	}
+	static void bindIdentity(wl_client* client, void* data, uint32_t version, uint32_t id) {
+		auto* resource = wl_resource_create(client, &lumen_toplevel_identity_manager_v1_interface, version, id);
+		ensure(resource);
+		static const struct lumen_toplevel_identity_manager_v1_interface implementation = {destroyManager, resolve};
+		wl_resource_set_implementation(resource, &implementation, data, nullptr);
+	}
+	static void bindForeign(wl_client* client, void* data, uint32_t version, uint32_t id) {
+		auto* wire = static_cast<Wire*>(data);
+		auto* manager = wl_resource_create(client, &zwlr_foreign_toplevel_manager_v1_interface, version, id);
+		wire->foreignResource = wl_resource_create(client, &zwlr_foreign_toplevel_handle_v1_interface, version, 0);
+		ensure(manager && wire->foreignResource);
+		zwlr_foreign_toplevel_manager_v1_send_toplevel(manager, wire->foreignResource);
+	}
+	wl_display* server = nullptr;
+	wl_display* client = nullptr;
+	wl_registry* registry = nullptr;
+	lumen_toplevel_identity_manager_v1* manager = nullptr;
+	zwlr_foreign_toplevel_manager_v1* foreignManager = nullptr;
+	zwlr_foreign_toplevel_handle_v1* handle = nullptr;
+	wl_resource* foreignResource = nullptr;
+	wl_resource* pending = nullptr;
+};
+
+class IdentityReplyTest: public QObject {
+	Q_OBJECT;
+private slots:
+	void terminal_data() {
+		QTest::addColumn<uint>("status"); QTest::addColumn<QByteArray>("identifier"); QTest::addColumn<QString>("expected");
+		QTest::newRow("available") << 1u << QByteArray("stable-identifier") << QString("stable-identifier");
+		QTest::newRow("unavailable") << 0u << QByteArray("") << QString();
+		QTest::newRow("unavailable-nonempty") << 0u << QByteArray("must-not-escape") << QString();
+		QTest::newRow("unknown-status") << 7u << QByteArray("must-not-escape") << QString();
+		QTest::newRow("oversized") << 1u << QByteArray(33, 'a') << QString();
+		QTest::newRow("control-character") << 1u << QByteArray("bad\nidentifier") << QString();
+	}
+	void terminal() {
+		QFETCH(uint, status); QFETCH(QByteArray, identifier); QFETCH(QString, expected);
+		Wire wire; QObject owner; int calls = 0; QString observed;
+		QPointer<IdentityReply> reply = wire.request(&owner, 42, [&](IdentityReply*, quint64 generation, const QString& value) {
+			QCOMPARE(generation, 42u); ++calls; observed = value;
+		});
+		wire.result(status, identifier.constData());
+		QCOMPARE(calls, 1); QCOMPARE(observed, expected); QVERIFY(reply.isNull());
+	}
+	void ownerDestroyedBeforeDelayedResult() {
+		Wire wire; auto* owner = new QObject; int calls = 0;
+		QPointer<IdentityReply> reply = wire.request(owner, 1, [&](IdentityReply*, quint64, const QString&) { ++calls; });
+		delete owner; QVERIFY(reply.isNull()); wire.result(1, "late-result"); QCOMPARE(calls, 0);
+	}
+	void cancelledGenerationBeforeDelayedResult() {
+		Wire wire; QObject owner; int calls = 0;
+		auto* pending = wire.request(&owner, 1, [&](IdentityReply*, quint64, const QString&) { ++calls; });
+		delete pending; wire.result(1, "old-generation"); QCOMPARE(calls, 0);
+		wire.request(&owner, 2, [&](IdentityReply*, quint64 generation, const QString&) { QCOMPARE(generation, 2u); ++calls; });
+		wire.result(1, "new-generation"); QCOMPARE(calls, 1);
+	}
+	void reentrantOwnerDestruction() {
+		Wire wire; auto* owner = new QObject; int calls = 0;
+		QPointer<IdentityReply> reply = wire.request(owner, 1, [&](IdentityReply*, quint64, const QString&) { ++calls; delete owner; });
+		wire.result(1, "stable"); QCOMPARE(calls, 1); QVERIFY(reply.isNull());
+	}
+	void malformedDuplicateTerminal() {
+		Wire wire; QObject owner; int calls = 0;
+		wire.request(&owner, 1, [&](IdentityReply*, quint64, const QString&) { ++calls; });
+		wire.result(1, "stable", true); QCOMPARE(calls, 1);
+	}
+};
+QTEST_GUILESS_MAIN(IdentityReplyTest)
+#include "identity_reply_test.moc"
diff --git a/src/wayland/toplevel/lumen-toplevel-identity-v1.xml b/src/wayland/toplevel/lumen-toplevel-identity-v1.xml
