+        guard->setProperty("surface", QVariant::fromValue<QObject *>(window->waylandSurface()));
+        setProperty("_q_lumenPressedSurfaceGuard", QVariant::fromValue(guard));
+        auto retirePress = [this, guard] {
+            if (property("_q_lumenPressedSurfaceGuard").value<QObject *>() != guard)
+                return;
+            setProperty("_q_lumenPressedSurfaceGuard", QVariant());
