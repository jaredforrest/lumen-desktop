@@ -0,0 +1,15 @@
+#ifndef SWAY_LUMEN_SHORTCUT_LAYOUT_H
+#define SWAY_LUMEN_SHORTCUT_LAYOUT_H
+#include <json.h>
+#include <stddef.h>
+struct sway_seat;
+struct lumen_shortcut_observation {
+	size_t remaining;
+	size_t seats;
+	json_object *bindings;
+};
+void lumen_shortcut_observation_init(struct lumen_shortcut_observation *observation);
+void lumen_shortcut_observation_finish(struct lumen_shortcut_observation *observation);
+json_object *lumen_shortcut_layout(struct sway_seat *seat,
+	struct lumen_shortcut_observation *observation);
+#endif
