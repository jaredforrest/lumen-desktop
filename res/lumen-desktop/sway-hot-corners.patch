+/* Corner occupancy is driven only by physical pointer motion. */
+static const char *hot_corner_names[] = {
+	NULL, "top-left", "top-right", "bottom-left", "bottom-right"
+};
+
+static struct sway_output *hot_corner_output(struct sway_cursor *cursor) {
+	for (int i = 0; i < root->outputs->length; ++i) {
+		struct sway_output *output = root->outputs->items[i];
+		if (output->node.id == cursor->hot_corner_output_id) {
+			return output;
+		}
+	}
+	return NULL;
+}
+
+static void hot_corner_emit(struct sway_cursor *cursor,
+		struct sway_output *output, int corner, bool adjacent) {
+	json_object *event = json_object_new_object();
+	json_object_object_add(event, "kind", json_object_new_string("lumen-corner"));
+	json_object_object_add(event, "version", json_object_new_int(1));
+	json_object_object_add(event, "corner", corner ?
+		json_object_new_string(hot_corner_names[corner]) : NULL);
+	json_object_object_add(event, "output", json_object_new_string(
+		output ? output->wlr_output->name : "unavailable"));
+	json_object_object_add(event, "locked",
+		json_object_new_boolean(server.session_lock.lock != NULL));
+	json_object_object_add(event, "fullscreen", json_object_new_boolean(
+		root->fullscreen_global || (output && output->current.active_workspace &&
+		output->current.active_workspace->fullscreen)));
+	json_object_object_add(event, "adjacent", json_object_new_boolean(adjacent));
+	json_object *modifiers = json_object_new_array();
+	struct wlr_keyboard *keyboard = wlr_seat_get_keyboard(cursor->seat->wlr_seat);
+	uint32_t mods = keyboard ? wlr_keyboard_get_modifiers(keyboard) : 0;
+	const uint32_t bits[] = { WLR_MODIFIER_SHIFT, WLR_MODIFIER_CTRL,
+		WLR_MODIFIER_ALT, WLR_MODIFIER_LOGO };
+	const char *names[] = { "shift", "control", "alt", "super" };
+	for (size_t i = 0; i < sizeof(bits) / sizeof(bits[0]); ++i) {
+		if (mods & bits[i]) {
+			json_object_array_add(modifiers, json_object_new_string(names[i]));
+		}
+	}
+	json_object_object_add(event, "modifiers", modifiers);
+	ipc_event_tick(json_object_to_json_string_ext(event, JSON_C_TO_STRING_PLAIN));
+	json_object_put(event);
+}
+
+void cursor_hot_corners_lock_changed(void) {
+	struct sway_seat *seat;
+	wl_list_for_each(seat, &server.input->seats, link) {
+		/* Preserve occupancy across lock/unlock: returning cannot re-enter. */
+		hot_corner_emit(seat->cursor, hot_corner_output(seat->cursor), 0, false);
+	}
+}
+
+static void hot_corner_motion(struct sway_cursor *cursor) {
+	double x = cursor->cursor->x, y = cursor->cursor->y;
+	if (cursor->hot_corner) {
+		if (hot_corner_output(cursor) &&
+				fabs(x - cursor->hot_corner_x) <= 8 &&
+				fabs(y - cursor->hot_corner_y) <= 8) {
+			return;
+		}
+		hot_corner_emit(cursor, hot_corner_output(cursor), 0, false);
+		cursor->hot_corner = 0;
+	}
+	struct wlr_output *wlr_output = wlr_output_layout_output_at(
+		root->output_layout, x, y);
+	if (!wlr_output) {
+		return;
+	}
+	struct sway_output *output = wlr_output->data;
+	struct wlr_box box;
+	wlr_output_layout_get_box(root->output_layout, wlr_output, &box);
+	bool left = x - box.x <= 1, right = box.x + box.width - x <= 1;
+	bool top = y - box.y <= 1, bottom = box.y + box.height - y <= 1;
+	int corner = top ? (left ? 1 : right ? 2 : 0) :
+		bottom ? (left ? 3 : right ? 4 : 0) : 0;
+	if (!corner) {
+		return;
+	}
+	cursor->hot_corner = corner;
+	cursor->hot_corner_output_id = output->node.id;
+	cursor->hot_corner_x = left ? box.x : box.x + box.width;
+	cursor->hot_corner_y = top ? box.y : box.y + box.height;
+	bool adjacent = false;
+	for (int dx = -1; dx <= 1; dx += 2) {
+		for (int dy = -1; dy <= 1; dy += 2) {
+			struct wlr_output *neighbor = wlr_output_layout_output_at(
+				root->output_layout, cursor->hot_corner_x + dx * 0.5,
+				cursor->hot_corner_y + dy * 0.5);
+			adjacent |= neighbor && neighbor != wlr_output;
+		}
+	}
+	/* A drag or locked entry still occupies the corner until an actual leave. */
+	hot_corner_emit(cursor, output,
+		(cursor->pressed_button_count || server.session_lock.lock) ? 0 : corner,
+		adjacent);
+}
