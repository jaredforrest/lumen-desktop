diff --git a/sway/toplevel_identity.c b/sway/toplevel_identity.c
new file mode 100644
index 0000000..79e843a
--- /dev/null
+++ b/sway/toplevel_identity.c
@@ -0,0 +1,88 @@
+#include <stdbool.h>
+#include <stdint.h>
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_ext_foreign_toplevel_list_v1.h>
+#include <wlr/types/wlr_foreign_toplevel_management_v1.h>
+#include "sway/toplevel_identity.h"
+#include "sway/tree/container.h"
+#include "sway/tree/root.h"
+#include "sway/tree/view.h"
+#include "lumen-toplevel-identity-v1-protocol.h"
+
+struct identity_lookup {
+	struct wl_resource *handle;
+	const char *identifier;
+	unsigned matches;
+};
+
+static void lookup_container(struct sway_container *container, void *data) {
+	struct identity_lookup *lookup = data;
+	struct sway_view *view = container->view;
+	if (!view || !view->foreign_toplevel || !view->ext_foreign_toplevel) {
+		return;
+	}
+	// Never interpret user data from the generic argument. Exact membership
+	// validates both its interface and its current live view ownership.
+	struct wl_resource *resource;
+	wl_resource_for_each(resource, &view->foreign_toplevel->resources) {
+		if (resource == lookup->handle) {
+			++lookup->matches;
+			lookup->identifier = view->ext_foreign_toplevel->identifier;
+		}
+	}
+}
+
+static void manager_destroy(struct wl_client *client, struct wl_resource *resource) {
+	(void)client;
+	wl_resource_destroy(resource);
+}
+
+static void manager_resolve(struct wl_client *client, struct wl_resource *manager,
+		uint32_t id, struct wl_resource *handle) {
+	(void)manager;
+	struct wl_resource *reply = wl_resource_create(client,
+		&lumen_toplevel_identity_reply_v1_interface, 1, id);
+	if (!reply) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	struct identity_lookup lookup = {.handle = handle};
+	if (handle && wl_resource_get_client(handle) == client) {
+		root_for_each_container(lookup_container, &lookup);
+	}
+	bool available = lookup.matches == 1 && lookup.identifier && lookup.identifier[0];
+	lumen_toplevel_identity_reply_v1_send_result(reply,
+		available ? LUMEN_TOPLEVEL_IDENTITY_REPLY_V1_STATUS_AVAILABLE
+			: LUMEN_TOPLEVEL_IDENTITY_REPLY_V1_STATUS_UNAVAILABLE,
+		available ? lookup.identifier : "");
+	// Immediate one-shot result: no deferred work, retained argument pointer,
+	// cancellation race or per-client resource accumulation.
+	wl_resource_destroy(reply);
+}
+
+static const struct lumen_toplevel_identity_manager_v1_interface manager_impl = {
+	.destroy = manager_destroy,
+	.resolve = manager_resolve,
+};
+
+static void manager_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id) {
+	(void)data;
+	struct wl_resource *resource = wl_resource_create(client,
+		&lumen_toplevel_identity_manager_v1_interface, version, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(resource, &manager_impl, NULL, NULL);
+}
+
+bool sway_toplevel_identity_init(struct wl_display *display) {
+	return wl_global_create(display, &lumen_toplevel_identity_manager_v1_interface,
+		1, NULL, manager_bind) != NULL;
+}
+
+bool sway_toplevel_identity_is_privileged(const struct wl_global *global) {
+	// Interface comparison works during wl_global_create before its return and
+	// keeps security-context visibility aligned with both foreign managers.
+	return wl_global_get_interface(global) == &lumen_toplevel_identity_manager_v1_interface;
+}
