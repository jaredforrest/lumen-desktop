             # so an Upload that never passed an Ask has nothing vouching for it.
             self._contacts_ok = True
 
+        # Do not answer /Ask or write link items until the desktop user accepts.
+        # Limit concurrent dialogs; a missing UI, timeout or error fails closed.
+        if not CONSENT_LOCK.acquire(blocking=False):
+            self.reject(503, 'another AirDrop decision is in progress')
+            return
+        try:
+            approved = False
+            if CONSENT_COMMAND:
+                try:
+                    decision = subprocess.run(
+                        [CONSENT_COMMAND],
+                        input=json.dumps({
+                            'sender': ask.get('SenderComputerName'),
+                            'files': [{'name': f.get('FileName')} for f in files
+                                      if isinstance(f, dict)],
+                        }),
+                        text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                        timeout=50, check=False,
+                    )
+                    approved = decision.returncode == 0 and decision.stdout.strip() == 'accept'
+                except (OSError, subprocess.TimeoutExpired):
+                    pass
+            if not approved:
+                logging.info('ask declined by desktop user or unavailable UI')
+                self.send_response(403)
+                self.send_header('Content-Length', '0')
+                self.end_headers()
