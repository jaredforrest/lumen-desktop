+bool container_lumen_preferred_size(struct sway_container *con, int width, int height) {
+ if (!con || con->node.destroying || !con->view || !con->view->surface ||
+   width < 1 || height < 1 || width > 32768 || height > 32768) return false;
+ con->lumen_preferred_width = width;
+ con->lumen_preferred_height = height;
+ node_set_dirty(&con->node);
+ return true;
+}
+
+bool container_lumen_zoom_supported(struct sway_container *con) {
+ if (!container_lumen_action_enabled(con, 2) || !con->pending.workspace ||
+   con->scratchpad || con->pending.fullscreen_mode != FULLSCREEN_NONE ||
+   con->lumen_pair || con->lumen_pair_restore || !container_is_floating(con) ||
+   con->lumen_preferred_width < 1 || con->lumen_preferred_height < 1) return false;
+ struct sway_view *parent = NULL;
+ int modal = -1;
+ if (!lumen_view_relationship(con->view, &parent, &modal) || parent || modal == 1) return false;
+ int border = con->pending.border == B_CSD || con->pending.border == B_NONE ?
+  0 : con->pending.border_thickness;
+ double top = con->pending.border == B_NORMAL ? (double)container_titlebar_height() : border;
+ double minw, maxw, minh, maxh;
+ view_get_constraints(con->view, &minw, &maxw, &minh, &maxh);
+ return isfinite(minw) && isfinite(minh) && maxw >= 1 && maxh >= 1 &&
+  minw <= maxw && minh <= maxh &&
+  minw <= con->pending.workspace->width - 2 * border &&
+  minh <= con->pending.workspace->height - top - border;
+}
+
+bool container_lumen_zoom(struct sway_container *con) {
+ if (!container_lumen_zoom_supported(con)) return false;
+ if (con->lumen_zoomed && con->lumen_filled) {
+  container_lumen_restore(con);
+  return true;
+ }
+ struct sway_workspace *ws = con->pending.workspace;
+ int border = con->pending.border == B_CSD || con->pending.border == B_NONE ?
+  0 : con->pending.border_thickness;
+ double top = con->pending.border == B_NORMAL ? (double)container_titlebar_height() : border;
+ double minw, maxw, minh, maxh;
+ view_get_constraints(con->view, &minw, &maxw, &minh, &maxh);
+ double availablew = ws->width - 2 * border;
+ double availableh = ws->height - top - border;
+ if (availablew < 1 || availableh < 1 || minw > availablew || minh > availableh) return false;
+ double width = fmin(availablew, fmin(maxw, fmax(minw, con->lumen_preferred_width)));
+ double height = fmin(availableh, fmin(maxh, fmax(minh, con->lumen_preferred_height)));
+ if (!isfinite(width) || !isfinite(height) || width < 1 || height < 1) return false;
+ if (!con->lumen_filled) con->lumen_filled = lumen_save(con);
+ if (!con->lumen_filled) return false;
+ con->lumen_zoomed = true;
+ con->pending.content_width = width;
+ con->pending.content_height = height;
+ double x = fmax(ws->x, fmin(con->pending.x, ws->x + ws->width - width - 2 * border));
+ double y = fmax(ws->y, fmin(con->pending.y, ws->y + ws->height - height - top - border));
+ con->pending.content_x = x + border;
+ con->pending.content_y = y + top;
+ container_set_geometry_from_content(con);
+ arrange_workspace(ws);
+ node_set_dirty(&con->node);
+ return true;
 }
 
