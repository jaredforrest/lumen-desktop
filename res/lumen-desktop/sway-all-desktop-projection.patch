diff --git a/sway/tree/lumen_projection.c b/sway/tree/lumen_projection.c
new file mode 100644
index 0000000..e940a82
--- /dev/null
+++ b/sway/tree/lumen_projection.c
@@ -0,0 +1,288 @@
+/* One scene node, structural origin retained. This is floating presentation of
+ * ordinary tiled views, not a second tiled layout or an always-on-top plane. */
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/types/wlr_ext_foreign_toplevel_list_v1.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_xdg_shell.h>
+#include "sway/commands.h"
+#include "sway/desktop/transaction.h"
+#include "sway/ipc-server.h"
+#include "sway/input/input-manager.h"
+#include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/server.h"
+#include "sway/tree/container.h"
+#include "sway/tree/lumen_groups.h"
+#include "sway/tree/lumen_projection.h"
+#include "sway/tree/root.h"
+#include "sway/tree/view.h"
+#include "sway/tree/workspace.h"
+
+static bool name_ok(const char *name) {
+ if (!name || !*name || strlen(name) > 4096) return false;
+ for (const unsigned char *p = (const unsigned char *)name; *p; ++p)
+  if (*p < 32 || *p == 127 || (*p == 0xc2 && p[1] >= 0x80 && p[1] <= 0x9f)) return false;
+ return true;
+}
+static const char *static_reason(struct sway_container *con) {
+ if (!con || !con->view || con->node.destroying || con->view->pid <= 0) return "native-view-required";
+ bool managed_role = con->view->type == SWAY_VIEW_XDG_SHELL;
+#if WLR_HAS_XWAYLAND
+ managed_role = managed_role || con->view->type == SWAY_VIEW_XWAYLAND;
+#endif
+ if (!managed_role) return "native-view-required";
+ if (!con->view->ext_foreign_toplevel) return "identity-unavailable";
+ if (!con->pending.workspace || !con->pending.workspace->output || con->pending.workspace->node.destroying) return "origin-unavailable";
+ struct sway_output *output = con->pending.workspace->output;
+ if (output->node.destroying || !output->wlr_output || !output->enabled || !output->wlr_output->enabled) return "output-unavailable";
+ if (con->lumen_projection_exhausted) return "revision-exhausted";
+ if (con->lumen_pair || con->lumen_pair_restore || con->lumen_pair_dialog_owner) return "paired-layout-unsupported";
+ if (con->pending.fullscreen_mode != FULLSCREEN_NONE || root->fullscreen_global) return "fullscreen-suspended";
+ struct sway_workspace *active = output_get_active_workspace(output);
+ if (con->pending.workspace->fullscreen || (active && active->fullscreen)) return "fullscreen-suspended";
+ if (container_is_sticky_or_child(con)) return "native-sticky-owned-elsewhere";
+ if (!name_ok(con->pending.workspace->name) || !name_ok(output->wlr_output->name) ||
+     (con->lumen_projection_enabled && active && !name_ok(active->name))) return "metadata-bounds";
+ return NULL;
+}
+/* Direct flags only: no assignment is inherited from a parent or application ID.
+ * One bounded known family must converge before any member is projected. */
+static struct sway_view *family_root(struct sway_view *view) {
+ /* The seventeenth node is an overflow witness, never an authorized member. */
+ for (size_t depth = 0; depth <= 16; ++depth) {
+  struct sway_view *parent = NULL; int modal = -1;
+  if (!lumen_view_relationship(view, &parent, &modal)) return NULL;
+  if (!parent) return view;
+  if (parent == view || !parent->container || parent->container->node.destroying) return NULL;
+  view = parent;
+ }
+ return NULL;
+}
+struct family_search {
+ struct sway_view *root; struct sway_workspace *origin;
+ size_t count; bool pending, modal; const char *failure; uint64_t fingerprint;
+ struct sway_container *members[16];
+};
+static void family_member(struct sway_container *con, void *data) {
+ struct family_search *s = data;
+ if (!con->view || con->node.destroying || family_root(con->view) != s->root) return;
+ if (s->count >= 16) {s->count = 17; s->failure = "owned-family-bounds"; return;}
+ s->members[s->count++] = con;
+}
+static int member_order(const void *left, const void *right) {
+ const struct sway_container *a = *(struct sway_container *const *)left;
+ const struct sway_container *b = *(struct sway_container *const *)right;
+ return a->node.id < b->node.id ? -1 : a->node.id > b->node.id;
+}
+static void family_facts(struct sway_container *con, struct family_search *s) {
+ struct sway_view *parent = NULL; int modal = -1;
+ if (!lumen_view_relationship(con->view, &parent, &modal)) {s->failure = "relationship-unsupported"; return;}
+ const char *why = static_reason(con);
+ if (why && !s->failure) s->failure = why;
+ if (con->pending.workspace != s->origin && !s->failure) s->failure = "owned-family-origin-mismatch";
+ s->modal |= modal == 1;
+ s->pending |= !con->lumen_projection_enabled;
+ uint64_t facts[] = {con->node.id, parent && parent->container ? parent->container->node.id : 0,
+  con->lumen_projection_enabled, (uint64_t)(modal + 1),
+  con->pending.workspace ? con->pending.workspace->node.id : 0};
+ for (size_t i = 0; i < sizeof(facts)/sizeof(facts[0]); ++i) {
+  s->fingerprint ^= facts[i]; s->fingerprint *= UINT64_C(1099511628211);
+ }
+}
+static struct family_search family(struct sway_container *con) {
+ struct family_search s = {.root = con && con->view ? family_root(con->view) : NULL,
+  .origin = con ? con->pending.workspace : NULL, .fingerprint = UINT64_C(1469598103934665603)};
+ if (!s.root) {s.failure = "relationship-unsupported"; return s;}
+ root_for_each_container(family_member, &s);
+ if (s.count > 16) {s.fingerprint ^= 17; return s;}
+ qsort(s.members, s.count, sizeof(s.members[0]), member_order);
+ for (size_t i = 0; i < s.count; ++i) family_facts(s.members[i], &s);
+ return s;
+}
+static const char *reason(struct sway_container *con) {
+ const char *why = static_reason(con);
+ if (why) return why;
+ struct family_search s = family(con);
+ if (s.failure) return s.failure;
+ if (s.modal) return "modal-owner-suspended";
+ return s.count > 1 && s.pending ? "owned-family-pending" : NULL;
+}
+struct sway_workspace *lumen_projection_map_workspace(struct sway_view *view, struct sway_workspace *proposed) {
+ struct sway_view *parent = NULL; int modal = -1;
+ if (!view || !lumen_view_relationship(view, &parent, &modal) || !parent || !parent->container) return proposed;
+ struct sway_view *root_view = family_root(parent);
+ if (!root_view || !root_view->container) return proposed;
+ struct family_search s = family(root_view->container);
+ if (!s.count || !s.origin || !s.origin->output ||
+     parent->container->pending.workspace != s.origin ||
+     parent->container->lumen_pair || parent->container->lumen_pair_restore ||
+     parent->container->lumen_pair_dialog_owner) return proposed;
+ bool assigned = false;
+ /* Pending direct intents are represented on existing family members only. */
+ struct sway_view *walk = parent;
+ for (size_t depth = 0; walk && depth < 16; ++depth) {
+  assigned |= walk->container && walk->container->lumen_projection_enabled;
+  struct sway_view *next = NULL; int ignored = -1;
+  if (!lumen_view_relationship(walk, &next, &ignored)) return proposed;
+  walk = next;
+ }
+ return assigned && s.origin ? s.origin : proposed;
+}
+struct sway_workspace *lumen_projection_workspace(struct sway_container *con) {
+ struct sway_workspace *origin = con ? con->pending.workspace : NULL;
+ if (!con || !con->lumen_projection_enabled || reason(con) || !origin) return origin;
+ struct sway_output *output = origin->output;
+ if (!output || !output->enabled || !output->wlr_output || !output->wlr_output->enabled) return origin;
+ struct sway_workspace *active = output_get_active_workspace(output);
+ return active && !active->node.destroying && strlen(active->name) <= 4096 ? active : origin;
+}
+bool lumen_projection_reserved(struct sway_container *con) {
+ return con && con->lumen_projection_enabled && !reason(con);
+}
+bool lumen_projection_presented(struct sway_container *con) {
+ if (!lumen_projection_reserved(con) || !con->pending.workspace) return false;
+ struct sway_workspace *effective = lumen_projection_workspace(con);
+ return effective && effective->output && effective->output->enabled &&
+  output_get_active_workspace(effective->output) == effective && !effective->fullscreen &&
+  !con->scratchpad && !con->lumen_minimized && !con->lumen_app_hidden && !con->lumen_desktop_hidden && lumen_groups_visible(con);
+}
+static void advance(struct sway_container *con) {
+ if (con->lumen_projection_revision == UINT64_MAX) con->lumen_projection_exhausted = true;
+ else ++con->lumen_projection_revision;
+}
+static void origin_changed(struct sway_container *con, void *data) {
+ (void)data;
+ if (con->view && con->lumen_projection_enabled) advance(con);
+}
+void lumen_projection_origin_changed(struct sway_container *con) {
+ origin_changed(con, NULL); container_for_each_child(con, origin_changed, NULL);
+}
+static void output_changed(struct sway_container *con, void *data) {
+ if (con->view && con->lumen_projection_enabled && con->pending.workspace &&
+     con->pending.workspace->output == data) {
+  advance(con); ipc_event_window(con, "lumen_projection");
+ }
+}
+void lumen_projection_workspace_changed(struct sway_workspace *old_ws, struct sway_workspace *new_ws) {
+ if (new_ws && new_ws->output && old_ws != new_ws &&
+     ((old_ws && old_ws->output == new_ws->output) || new_ws->output->current.active_workspace != new_ws))
+  root_for_each_container(output_changed, new_ws->output);
+}
+static bool projected_child(struct sway_container *con, void *data) {
+ (void)data;
+ return con->lumen_projection_enabled && con->pending.workspace && con->pending.workspace->output &&
+  output_get_active_workspace(con->pending.workspace->output) != con->pending.workspace;
+}
+bool lumen_projection_prepare_fullscreen(struct sway_container *con) {
+ if (!con) return false;
+ struct sway_container *target = projected_child(con, NULL) ? con :
+  container_find_child(con, projected_child, NULL);
+ if (!target) return true;
+ if (reason(target)) return false;
+ struct sway_seat *seat = input_manager_current_seat();
+ struct sway_container *focused = seat_get_focused_container(seat);
+ if (!focused || (focused != con && !container_has_ancestor(focused, con))) return false;
+ /* Fullscreen is a deliberate origin-Space transition, never an implicit move
+  * of a retained structural slot. Background requests cannot steal focus. */
+ seat_set_focus(seat, &target->pending.workspace->node);
+ return seat_get_focused_workspace(seat) == target->pending.workspace;
+}
+static void sync_observation(struct sway_container *con, bool notify) {
+ if (!con->view || con->node.destroying) return;
+ struct sway_workspace *origin = con->pending.workspace;
+ struct sway_workspace *effective = lumen_projection_workspace(con);
+ uint64_t ws = origin ? origin->node.id : 0;
+ uint64_t out = origin && origin->output ? origin->output->node.id : 0;
+ uint64_t effective_id = effective ? effective->node.id : 0;
+ bool supported = reason(con) == NULL;
+ struct family_search family_state = family(con);
+ if (con->lumen_projection_origin != ws || con->lumen_projection_output != out ||
+     con->lumen_projection_effective != effective_id || con->lumen_projection_supported != supported ||
+     con->lumen_projection_family != family_state.fingerprint) {
+  con->lumen_projection_origin = ws; con->lumen_projection_output = out;
+  con->lumen_projection_effective = effective_id; con->lumen_projection_supported = supported;
+  con->lumen_projection_family = family_state.fingerprint;
+  advance(con);
+  if (notify) ipc_event_window(con, "lumen_projection");
+ }
+}
+static void reconcile(struct sway_container *con, void *data) {
+ (void)data; sync_observation(con, true);
+}
+void lumen_projection_reconcile(void) { root_for_each_container(reconcile, NULL); }
+void lumen_projection_raise(struct sway_container *con) {
+ if (lumen_projection_presented(con)) wlr_scene_node_raise_to_top(&con->scene_tree->node);
+}
+static json_object *named(struct sway_node *node, const char *name) {
+ if (!node || !name_ok(name)) return NULL;
+ char id[32]; snprintf(id, sizeof(id), "%"PRIu64, node->id);
+ json_object *result = json_object_new_object();
+ json_object_object_add(result, "id", json_object_new_string(id));
+ json_object_object_add(result, "name", json_object_new_string(name ? name : ""));
+ return result;
+}
+json_object *lumen_projection_json(struct sway_container *con) {
+ /* Publish live relationship facts and their matching revision together. A
+  * transaction may not yet have sampled a newly mapped/reparented member. */
+ sync_observation(con, false);
+ json_object *result = json_object_new_object();
+ struct sway_workspace *origin = con->pending.workspace, *effective = lumen_projection_workspace(con);
+ struct sway_output *out = origin ? origin->output : NULL, *effective_out = effective ? effective->output : NULL;
+ char revision[32]; snprintf(revision, sizeof(revision), "%"PRIu64, con->lumen_projection_revision);
+ const char *why = reason(con);
+ json_object_object_add(result, "version", json_object_new_int(1));
+ json_object_object_add(result, "enabled", json_object_new_boolean(con->lumen_projection_enabled));
+ json_object_object_add(result, "supported", json_object_new_boolean(!why));
+ json_object_object_add(result, "reason", why ? json_object_new_string(why) : NULL);
+ json_object_object_add(result, "revision", json_object_new_string(revision));
+ json_object_object_add(result, "projected", json_object_new_boolean(effective && effective != origin));
+ json_object_object_add(result, "origin_workspace", named(origin ? &origin->node : NULL, origin ? origin->name : NULL));
+ json_object_object_add(result, "origin_output", named(out ? &out->node : NULL, out && out->wlr_output ? out->wlr_output->name : NULL));
+ json_object_object_add(result, "effective_workspace", named(effective ? &effective->node : NULL, effective ? effective->name : NULL));
+ json_object_object_add(result, "effective_output", named(effective_out ? &effective_out->node : NULL, effective_out && effective_out->wlr_output ? effective_out->wlr_output->name : NULL));
+ return result;
+}
+static bool decimal(const char *text, uint64_t *value) {
+ if (!text || !*text || strlen(text) > 20 || (text[0] == '0' && text[1])) return false;
+ for (const char *p = text; *p; ++p) if (*p < '0' || *p > '9') return false;
+ errno = 0; char *end; unsigned long long parsed = strtoull(text, &end, 10);
+ if (errno || *end) return false;
+ *value = parsed; return true;
+}
+static bool find_id(struct sway_container *con, void *data) { return !con->node.destroying && con->node.id == *(uint64_t *)data; }
+struct cmd_results *cmd_lumen_projection(int argc, char **argv) {
+ uint64_t id, pid, workspace, output, revision;
+ if (argc != 7 || !decimal(argv[0], &id) || !decimal(argv[2], &pid) || !decimal(argv[3], &workspace) || !decimal(argv[4], &output) || !decimal(argv[5], &revision) || (strcmp(argv[6], "on") && strcmp(argv[6], "off"))) return cmd_results_new(CMD_INVALID, "Invalid projection witness");
+ if (strlen(argv[1]) != 32 || strspn(argv[1], "0123456789abcdef") != 32) return cmd_results_new(CMD_INVALID, "Invalid projection identity");
+ struct sway_container *con = root_find_container(find_id, &id);
+ if (con && con->view) sync_observation(con, false);
+ if (!con || !con->view || !con->view->ext_foreign_toplevel || (uint64_t)con->view->pid != pid || strcmp(con->view->ext_foreign_toplevel->identifier, argv[1]) || !con->pending.workspace || con->pending.workspace->node.id != workspace || !con->pending.workspace->output || con->pending.workspace->output->node.id != output || con->lumen_projection_revision != revision || con->lumen_projection_exhausted) return cmd_results_new(CMD_INVALID, "Projection witness unavailable");
+ if (server.session_lock.lock) return cmd_results_new(CMD_INVALID, "Projection unavailable while session locked");
+ bool enabled = !strcmp(argv[6], "on");
+ const char *why = reason(con);
+ if (enabled && why && strcmp(why, "owned-family-pending")) return cmd_results_new(CMD_INVALID, "Projection unavailable");
+ if (con->lumen_projection_enabled != enabled) {
+  struct sway_seat *seat = input_manager_current_seat();
+  struct sway_container *focused = seat_get_focused_container(seat);
+  bool foreground = focused && focused->view && lumen_projection_presented(focused) &&
+   family_root(focused->view) == family_root(con->view);
+  con->lumen_projection_enabled = enabled; advance(con);
+  node_set_dirty(&con->node); lumen_projection_reconcile();
+  /* An explicit direct clear may suspend a whole family. Keep its exact
+   * foreground view usable at retained origin, without moving structural slots
+   * or stealing focus for unrelated/background convergence. */
+  if (foreground && !lumen_projection_presented(focused) && focused->pending.workspace &&
+      focused->pending.workspace->output &&
+      output_get_active_workspace(focused->pending.workspace->output) != focused->pending.workspace) {
+   seat_set_focus(seat, &focused->pending.workspace->node);
+   seat_set_focus_container(seat, focused);
+  }
+  ipc_event_window(con, "lumen_projection"); transaction_commit_dirty();
+ }
+ return cmd_results_new(CMD_SUCCESS, NULL);
+}
