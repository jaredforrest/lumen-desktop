+	json_object *relationships = json_object_new_object();
+	json_object_object_add(relationships, "version", json_object_new_int(1));
+	struct sway_view *parent = NULL;
+	bool supported = c->view->type == SWAY_VIEW_XDG_SHELL;
+	if (supported && c->view->wlr_xdg_toplevel->parent) {
+		parent = view_from_wlr_xdg_surface(c->view->wlr_xdg_toplevel->parent->base);
+	}
+	json_object_object_add(relationships, "parent_supported", json_object_new_boolean(supported));
+	json_object_object_add(relationships, "parent",
+		parent && parent->container && parent->surface ?
+			json_object_new_int64(parent->container->node.id) : NULL);
+	struct wlr_xdg_dialog_v1 *dialog = supported ?
+		wlr_xdg_dialog_v1_try_from_wlr_xdg_toplevel(c->view->wlr_xdg_toplevel) : NULL;
+	json_object_object_add(relationships, "modal",
+		dialog ? json_object_new_boolean(dialog->modal) : NULL);
+	json_object_object_add(object, "lumen_relationships", relationships);
 	json_object_object_add(object, "pid", json_object_new_int(c->view->pid));
