+struct lumen_modal_search {
+	struct sway_container *parent;
+	struct sway_container *child;
+	bool ambiguous;
+};
+
+static void lumen_modal_child(struct sway_container *con, void *data) {
+	struct lumen_modal_search *search = data;
+	if (!con->view || !con->view->surface || con->view->type != SWAY_VIEW_XDG_SHELL) return;
+	struct wlr_xdg_toplevel *top = con->view->wlr_xdg_toplevel;
+	if (top->parent != search->parent->view->wlr_xdg_toplevel) return;
+	struct wlr_xdg_dialog_v1 *dialog = wlr_xdg_dialog_v1_try_from_wlr_xdg_toplevel(top);
+	if (!dialog || !dialog->modal) return;
+	if (search->child) search->ambiguous = true;
+	search->child = con;
+}
+
 static void seat_set_workspace_focus(struct sway_seat *seat, struct sway_node *node) {
+	// Modal protocol scope is the parent branch, never every window of an app.
+	if (node && node_is_view(node) && node->sway_container->view->type == SWAY_VIEW_XDG_SHELL) {
+		for (int depth = 0; depth < 64; ++depth) {
+			struct lumen_modal_search search = {.parent = node->sway_container};
+			root_for_each_container(lumen_modal_child, &search);
+			if (search.ambiguous) return;
+			if (!search.child) break;
+			node = &search.child->node;
+			if (depth == 63) return;
+		}
+	}
 	struct sway_node *last_focus = seat_get_focus(seat);
