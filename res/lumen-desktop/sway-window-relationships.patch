+static void lumen_relationship_changed(struct sway_view *view) {
+	if (!view || !view->surface || !view->container) return;
+	if (view->container->pending.workspace) arrange_workspace(view->container->pending.workspace);
+	struct sway_seat *seat;
+	wl_list_for_each(seat, &server.input->seats, link) {
+		struct sway_node *focus = seat_get_focus(seat);
+		if (focus) seat_set_focus(seat, focus);
+	}
+}
+
+struct lumen_dialog_watch {
+	struct wlr_xdg_dialog_v1 *dialog;
+	struct wl_listener modal;
+	struct wl_listener destroy;
+};
+
+static void lumen_dialog_modal(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct lumen_dialog_watch *watch = wl_container_of(listener, watch, modal);
+	lumen_relationship_changed(view_from_wlr_xdg_surface(watch->dialog->xdg_toplevel->base));
+}
+
+static void lumen_dialog_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct lumen_dialog_watch *watch = wl_container_of(listener, watch, destroy);
+	wl_list_remove(&watch->modal.link);
+	wl_list_remove(&watch->destroy.link);
+	free(watch);
+}
+
+static void lumen_new_dialog(struct wl_listener *listener, void *data) {
+	(void)listener;
+	struct wlr_xdg_dialog_v1 *dialog = data;
+	struct lumen_dialog_watch *watch = calloc(1, sizeof(*watch));
+	if (!watch) return;
+	watch->dialog = dialog;
+	watch->modal.notify = lumen_dialog_modal;
+	watch->destroy.notify = lumen_dialog_destroy;
+	wl_signal_add(&dialog->events.set_modal, &watch->modal);
+	wl_signal_add(&dialog->events.destroy, &watch->destroy);
+}
+
+struct lumen_dialog_manager_watch {
+	struct wl_listener new_dialog;
+	struct wl_listener destroy;
+};
+
+static void lumen_dialog_manager_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct lumen_dialog_manager_watch *watch = wl_container_of(listener, watch, destroy);
+	wl_list_remove(&watch->new_dialog.link);
+	wl_list_remove(&watch->destroy.link);
+	free(watch);
+}
+
+void lumen_xdg_dialog_init(struct wl_display *display) {
+	struct wlr_xdg_wm_dialog_v1 *manager = wlr_xdg_wm_dialog_v1_create(display, 1);
+	struct lumen_dialog_manager_watch *watch = calloc(1, sizeof(*watch));
+	if (!watch) return;
+	watch->new_dialog.notify = lumen_new_dialog;
+	watch->destroy.notify = lumen_dialog_manager_destroy;
+	wl_signal_add(&manager->events.new_dialog, &watch->new_dialog);
+	wl_signal_add(&manager->events.destroy, &watch->destroy);
+}
+
+static void lumen_set_parent(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct sway_xdg_shell_view *view = wl_container_of(listener, view, lumen_set_parent);
+	lumen_relationship_changed(&view->view);
+}
