+static bool create(struct sway_container *left,struct sway_container *right) {
+ if (!eligible(left)||!eligible(right)||left->lumen_pair||right->lumen_pair||left->lumen_pair_restore||right->lumen_pair_restore) return false;
+ struct sway_workspace *original=left->pending.workspace,*right_space=right->pending.workspace;struct sway_output *output=original->output;
+ double low,high;if(!output || !ratio_range(left,right,output->width,output->height,&low,&high))return false;
+ struct sway_lumen_pair *pair=calloc(1,sizeof(*pair));if(!pair)return false;
+ pair->members[0]=(struct lumen_pair_member){left,container_lumen_snapshot(left)};
+ pair->members[1]=(struct lumen_pair_member){right,container_lumen_snapshot(right)};
+ if(!pair->members[0].restore||!pair->members[1].restore){container_lumen_placement_free(pair->members[0].restore);container_lumen_placement_free(pair->members[1].restore);free(pair);return false;}
+ pair->members[0].restore->fullscreen=FULLSCREEN_NONE;pair->members[1].restore->fullscreen=FULLSCREEN_NONE;
+ struct sway_container *parent=container_create(NULL);
+ if(!parent){container_lumen_placement_free(pair->members[0].restore);container_lumen_placement_free(pair->members[1].restore);free(pair);return false;}
+ char name[96];size_t suffix=0;
+ do {snprintf(name,sizeof(name),"paired-%llu-%zu",(unsigned long long)parent->node.id,suffix++);} while(workspace_by_name(name));
+ struct sway_workspace *space=workspace_create(output,name);
+ if(!space){container_begin_destroy(parent);container_lumen_placement_free(pair->members[0].restore);container_lumen_placement_free(pair->members[1].restore);free(pair);return false;}
+ changing++;
+ if(left->pending.fullscreen_mode!=FULLSCREEN_NONE)container_fullscreen_disable(left);
+ if(right->pending.fullscreen_mode!=FULLSCREEN_NONE)container_fullscreen_disable(right);
+ container_detach(left);container_detach(right);
+ parent->pending.layout=L_HORIZ;workspace_add_tiling(space,parent);
+ container_add_child(parent,left);container_add_child(parent,right);
+ parent->pending.width=output->width;parent->pending.height=output->height;
+ pair->parent=parent;parent->lumen_pair=pair;left->lumen_pair=pair;right->lumen_pair=pair;
+ pair_ratio(pair,.5);wl_list_insert(&pairs,&pair->link);
+ container_set_fullscreen(parent,FULLSCREEN_WORKSPACE);workspace_switch(space);
+ seat_set_focus(input_manager_current_seat(),&left->node);
+ if(!original->node.destroying)arrange_workspace(original);
+ if(right_space!=original && !right_space->node.destroying)arrange_workspace(right_space);
+ arrange_workspace(space);changing--;return true;
+}
+static bool replace(struct sway_container *kept,struct sway_container *replacement) {
+ struct sway_lumen_pair *pair=kept?kept->lumen_pair:NULL;
+ if (!pair || pair->parent==kept || !eligible(replacement) || replacement->lumen_pair || replacement->lumen_pair_restore) return false;
+ if(lumen_pair_revealed(kept))container_lumen_show_desktop(0);
+ int index=pair->members[0].con==kept ? 1 : 0;
+ double low,high;
+ struct sway_container *left=index==0?replacement:kept,*right=index==1?replacement:kept;
+ if(!ratio_range(left,right,pair->parent->pending.width,pair->parent->pending.height,&low,&high))return false;
+ struct sway_lumen_placement *saved=container_lumen_snapshot(replacement);if(!saved)return false;
+ saved->fullscreen=FULLSCREEN_NONE;
+ struct lumen_pair_member old=pair->members[index];
+ struct sway_workspace *replacement_space=replacement->pending.workspace;
+ changing++;if(replacement->pending.fullscreen_mode!=FULLSCREEN_NONE)container_fullscreen_disable(replacement);container_detach(replacement);
+ restore_member(&old,false);
+ pair->members[index]=(struct lumen_pair_member){replacement,saved};replacement->lumen_pair=pair;
+ container_insert_child(pair->parent,replacement,index);pair_ratio(pair,pair->ratio);
+ seat_set_focus(input_manager_current_seat(),&kept->node);
+ if(!replacement_space->node.destroying)arrange_workspace(replacement_space);
+ arrange_workspace(pair->parent->pending.workspace);changing--;return true;
+}
+json_object *lumen_pair_json(struct sway_container *con) {
+ json_object *state=json_object_new_object();
+ json_object_object_add(state,"version",json_object_new_int(1));
+ json_object_object_add(state,"eligible",json_object_new_boolean(eligible(con)));
+ json_object_object_add(state,"survivor",json_object_new_boolean(con->lumen_pair_restore!=NULL));
+ struct sway_lumen_pair *pair=con->lumen_pair;
+ if(pair && pair->parent!=con){int index=pair->members[1].con==con;
+  json_object_object_add(state,"id",json_object_new_int64(pair->parent->node.id));
+  json_object_object_add(state,"partner",json_object_new_int64(pair->members[1-index].con->node.id));
+  json_object_object_add(state,"side",json_object_new_string(index?"right":"left"));
+  json_object_object_add(state,"ratio",json_object_new_double(pair->ratio));
+ }
+ return state;
+}
+struct resize_operation {struct sway_lumen_pair *pair;double original,start_x,start_y;};
+static const struct sway_seatop_impl resize_impl;
+static void resize_motion(struct sway_seat *seat,uint32_t time) {
+ (void)time;struct resize_operation *op=seat->seatop_data;struct sway_container *parent=op->pair->parent;
+ if(fabs(seat->cursor->cursor->x-op->start_x)>4 || fabs(seat->cursor->cursor->y-op->start_y)>4)op->pair->last_click=0;
+ if(pair_ratio(op->pair,(seat->cursor->cursor->x-parent->pending.x)/parent->pending.width)) {
+  arrange_container(parent);transaction_commit_dirty();
+ }
+}
+static void resize_button(struct sway_seat *seat,uint32_t time,struct wlr_input_device *device,uint32_t button,enum wl_pointer_button_state state) {
+ (void)time;(void)device;(void)button;(void)state;
+ if(!seat->cursor->pressed_button_count)seatop_begin_default(seat);
+}
+static void resize_unref(struct sway_seat *seat,struct sway_container *con) {
+ struct resize_operation *op=seat->seatop_data;
+ if(con==op->pair->parent||con==op->pair->members[0].con||con==op->pair->members[1].con)seatop_begin_default(seat);
+}
+static const struct sway_seatop_impl resize_impl={.pointer_motion=resize_motion,.button=resize_button,.unref=resize_unref};
+bool lumen_pair_cancel_resize(struct sway_seat *seat) {
+ if(seat->seatop_impl!=&resize_impl)return false;
+ struct resize_operation *op=seat->seatop_data;op->pair->last_click=0;pair_ratio(op->pair,op->original);arrange_container(op->pair->parent);seatop_begin_default(seat);transaction_commit_dirty();return true;
+}
+bool lumen_pair_button(struct sway_seat *seat,uint32_t time,uint32_t button,enum wl_pointer_button_state state) {
+ if(button!=BTN_LEFT||state!=WL_POINTER_BUTTON_STATE_PRESSED||server.session_lock.lock||seat->cursor->active_constraint)return false;
+ double x=seat->cursor->cursor->x,y=seat->cursor->cursor->y;
