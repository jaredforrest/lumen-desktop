+ if (!con->node.destroying) container_lumen_restore_snapshot(con,member->restore,focus);
+ container_lumen_placement_free(member->restore);member->restore=NULL;
+}
+static void exit_all(struct sway_lumen_pair *pair) {
+ changing++;
+ container_fullscreen_disable(pair->parent);
+ restore_member(&pair->members[1],false);restore_member(&pair->members[0],true);
+ finish_parent(pair);changing--;
+}
+static void leave(struct sway_container *con,bool restore) {
+ struct sway_lumen_pair *pair=con->lumen_pair;
+ if (!pair || pair->parent==con) return;
+ int index=pair->members[1].con==con;
+ struct lumen_pair_member exiting=pair->members[index],survivor=pair->members[1-index];
+ struct sway_workspace *space=pair->parent->pending.workspace;
+ changing++;
+ container_fullscreen_disable(pair->parent);
+ con->lumen_pair=NULL;survivor.con->lumen_pair=NULL;
+ container_detach(con);container_detach(survivor.con);
+ workspace_add_tiling(space,survivor.con);
+ survivor.con->lumen_pair_restore=survivor.restore;
+ container_set_fullscreen(survivor.con,FULLSCREEN_WORKSPACE);
+ if (restore && !con->node.destroying) container_lumen_restore_snapshot(con,exiting.restore,true);
+ if(con->node.destroying){
+  struct sway_workspace *target=workspace_by_name(exiting.restore->workspace);
+  if(!target)target=workspace_create(space->output,exiting.restore->workspace);
+  follow_dialogs(con,target,true);
+ }
+ container_lumen_placement_free(exiting.restore);
