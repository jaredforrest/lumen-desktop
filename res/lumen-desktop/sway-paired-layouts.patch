+ struct sway_workspace *target=workspace_by_name(name);
+ if(target && target->fullscreen && target->fullscreen->lumen_pair)target=NULL;
+ if(!target){
+  char *fallback=workspace_by_name(name)?workspace_next_name(space->output->wlr_output->name):NULL;
+  target=workspace_create(space->output,fallback?fallback:name);free(fallback);
