+void lumen_pair_follow_dialogs(struct sway_container *con) {follow_dialogs(con,con->pending.workspace,false);}
+static bool primary_candidate(struct sway_container *con) {
+ if(con->lumen_pair_dialog_owner)return false;
+ if(con->view->type!=SWAY_VIEW_XDG_SHELL)return true;
+ struct wlr_xdg_toplevel *top=con->view->wlr_xdg_toplevel;
+ if(!top)return false;
+ struct wlr_xdg_dialog_v1 *dialog=wlr_xdg_dialog_v1_try_from_wlr_xdg_toplevel(top);
+ return !top->parent && !(dialog && dialog->modal);
+}
+static bool eligible(struct sway_container *con) {
+ return con && con->view && primary_candidate(con) && !con->node.destroying && con->pending.workspace &&
+  !con->scratchpad && !con->lumen_app_hidden && !con->lumen_minimized &&
+  !con->lumen_desktop_hidden && !owns_untagged_dialog(con) && container_lumen_action_enabled(con,2);
