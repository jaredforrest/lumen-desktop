+  struct sway_lumen_placement *restore=con->lumen_pair_restore;con->lumen_pair_restore=NULL;
+  changing++;container_fullscreen_disable(con);container_lumen_restore_snapshot(con,restore,true);
+  container_lumen_placement_free(restore);changing--;return true;
+ }
+ return false;
+}
+/* Relationship hints may change after map. Never retain stale dialog ownership. */
+static void refresh_dialog_owner(struct sway_container *con) {
+ if(!con->lumen_pair_dialog_owner || !con->view || moving_dialogs)return;
+ struct sway_container *old=find(con->lumen_pair_dialog_owner);
+ if(!old || !old->view){con->lumen_pair_dialog_owner=0;return;}
+ if(old->node.destroying || view_is_transient_for(con->view,old->view))return;
+ struct sway_container *owner=NULL;
+ if(con->view->type==SWAY_VIEW_XDG_SHELL && con->view->wlr_xdg_toplevel && con->view->wlr_xdg_toplevel->parent){
+  struct sway_view *view=view_from_wlr_surface(con->view->wlr_xdg_toplevel->parent->base->surface);
+  if(view)owner=view->container;
+ }
+ struct sway_workspace *target=owner?owner->pending.workspace:old->pending.workspace;
+ struct sway_lumen_placement *saved=old->lumen_pair_restore;
+ if(old->lumen_pair && old->lumen_pair->parent!=old){
+  int index=old->lumen_pair->members[1].con==old;saved=old->lumen_pair->members[index].restore;
+ }
+ if(!owner && saved && target){
+  struct sway_workspace *ordinary=workspace_by_name(saved->workspace);
+  if(!ordinary)ordinary=workspace_create(target->output,saved->workspace);
+  target=ordinary;
+ }
+ con->lumen_pair_dialog_owner=owner?owner->node.id:0;
+ if(target && target!=con->pending.workspace){
+  struct sway_workspace *source=con->pending.workspace;changing++;moving_dialogs++;
+  workspace_add_floating(target,con);container_floating_move_to_center(con);
+  if(source && !source->node.destroying)arrange_workspace(source);
+  arrange_workspace(target);moving_dialogs--;changing--;
+ }
+}
+static void collect_tracked_dialogs(struct sway_container *con,void *data) {
+ if(con->lumen_pair_dialog_owner && !con->node.destroying)list_add(data,con);
+}
+void lumen_pair_arrange(struct sway_container *con) {
+ if(!changing){
+  refresh_dialog_owner(con);
+  /* Fullscreen arrangement normally skips the workspace floating list. */
+  if(con->lumen_pair || con->lumen_pair_restore){
+   list_t *dialogs=create_list();root_for_each_container(collect_tracked_dialogs,dialogs);
+   for(int i=0;i<dialogs->length;i++)refresh_dialog_owner(dialogs->items[i]);
+   list_free(dialogs);
+  }
+ }
+ if (changing || con->lumen_desktop_hidden || !con->lumen_pair || con->lumen_pair->parent!=con) return;
+ struct sway_lumen_pair *pair=con->lumen_pair;
+ if(con->pending.children->length!=2 || con->pending.children->items[0]!=pair->members[0].con ||
+    con->pending.children->items[1]!=pair->members[1].con || !pair_ratio(pair,pair->ratio)) exit_all(pair);
+}
+bool lumen_pair_transient(struct sway_view *view,struct sway_container *parent) {
+ if(view && parent && parent->lumen_pair_restore && parent->view)return view_is_transient_for(view,parent->view);
+ struct sway_lumen_pair *pair=parent?parent->lumen_pair:NULL;
+ if(!view || !pair || pair->parent!=parent)return false;
+ return view_is_transient_for(view,pair->members[0].con->view) || view_is_transient_for(view,pair->members[1].con->view);
+}
+struct sway_workspace *lumen_pair_map_workspace(struct sway_view *view,struct sway_workspace *space) {
+ if(!space || !space->fullscreen)return space;
+ struct sway_container *fullscreen=space->fullscreen;
+ struct sway_lumen_pair *pair=fullscreen->lumen_pair;
+ struct sway_lumen_placement *restore=pair?pair->members[0].restore:fullscreen->lumen_pair_restore;
+ if(!restore)return space;
+ if(config->popup_during_fullscreen==POPUP_SMART && lumen_pair_transient(view,fullscreen)){
+  struct sway_container *owner=fullscreen;
+  if(pair)owner=view_is_transient_for(view,pair->members[0].con->view)?pair->members[0].con:pair->members[1].con;
+  view->container->lumen_pair_dialog_owner=owner->node.id;
+  return space;
+ }
