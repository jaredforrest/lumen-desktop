+static struct wl_list pairs = {&pairs,&pairs};
+static int changing;
+static bool matches(struct sway_container *con, void *data) {return con->node.id==*(uint64_t*)data;}
+static struct sway_container *find(uint64_t id) {return root_find_container(matches,&id);}
+static bool identity(const char *text,uint64_t *id) {
+ if (!text || !*text || *text=='-' || *text=='+') return false;
+ char *end;errno=0;unsigned long long value=strtoull(text,&end,10);
+ if (errno || *end || !value) return false;
