+void lumen_pair_detach(struct sway_container *con) {
+ if (changing || con->lumen_desktop_hidden) return;
+ if(con->lumen_pair && lumen_pair_revealed(con))container_lumen_show_desktop(0);
+ if (con->lumen_pair && con->lumen_pair->parent!=con) leave(con,false);
+ else if (con->lumen_pair && con->node.destroying) exit_all(con->lumen_pair);
+ else if (con->lumen_pair_restore && con->pending.workspace) {
+  if(con->node.destroying){
+   struct sway_workspace *target=workspace_by_name(con->lumen_pair_restore->workspace);
+   if(!target)target=workspace_create(con->pending.workspace->output,con->lumen_pair_restore->workspace);
+   follow_dialogs(con,target,true);
+  }
+  container_lumen_placement_free(con->lumen_pair_restore);con->lumen_pair_restore=NULL;
+ }
+}
+bool lumen_pair_revealed(struct sway_container *con) {
+ for(struct sway_container *parent=con;parent;parent=parent->pending.parent)if(parent->lumen_desktop_hidden)return true;
+ return false;
+}
+void lumen_pair_prepare_action(struct sway_container *con) {
+ if(changing || !con || (!con->lumen_pair && !con->lumen_pair_restore))return;
+ if(lumen_pair_revealed(con))container_lumen_show_desktop(0);
+ if(con->lumen_pair && con->lumen_pair->parent!=con)leave(con,true);
+ else if(con->lumen_pair_restore)lumen_pair_fullscreen(con,FULLSCREEN_NONE);
+}
+void lumen_pair_restore_revealed(struct sway_container *con,struct sway_lumen_placement *saved) {
+ changing++;container_lumen_restore_snapshot(con,saved,false);changing--;
+ if(con->pending.workspace)arrange_workspace(con->pending.workspace);
+}
+void lumen_pair_destroy(struct sway_container *con) {
+ if (con->lumen_pair_restore) container_lumen_placement_free(con->lumen_pair_restore);
+ con->lumen_pair_restore=NULL;
+}
+bool lumen_pair_fullscreen(struct sway_container *con,int mode) {
+ if (changing || con->lumen_desktop_hidden) return false;
+ if (con->lumen_pair) {
+  if (con->lumen_pair->parent==con) {if (mode==FULLSCREEN_NONE) exit_all(con->lumen_pair);else return false;}
+  else leave(con,true);
