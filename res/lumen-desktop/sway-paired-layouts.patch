+/* Native configure geometry includes decoration. Reserve it for client limits. */
+static void limits(struct sway_container *con,double *minimum,double *maximum,
+ double *minheight,double *maxheight) {
+ view_get_constraints(con->view,minimum,maximum,minheight,maxheight);
+ double border=con->pending.border==B_NORMAL ? config->font_height+config->titlebar_v_padding*2 : 0;
+ *minimum+=4;*maximum+=4;*minheight+=border+2;*maxheight+=border+2;
+}
+static bool ratio_range(struct sway_container *left,struct sway_container *right,
+ double width,double height,double *low,double *high) {
+ if (!eligible(left) || !eligible(right) || left==right || width<=0 || height<=0) return false;
+ double amin,amax,ahmin,ahmax,bmin,bmax,bhmin,bhmax;
+ limits(left,&amin,&amax,&ahmin,&ahmax);limits(right,&bmin,&bmax,&bhmin,&bhmax);
+ if (height<ahmin || height>ahmax || height<bhmin || height>bhmax) return false;
+ *low=fmax(amin/width,1-bmax/width);*high=fmin(amax/width,1-bmin/width);
+ return *low<=*high && *low>0 && *high<1;
+}
+static bool pair_ratio(struct sway_lumen_pair *pair,double ratio) {
+ double low,high;struct sway_container *parent=pair->parent;
+ if (!ratio_range(pair->members[0].con,pair->members[1].con,parent->pending.width,
+   parent->pending.height,&low,&high)) return false;
+ pair->ratio=fmax(low,fmin(high,ratio));
+ pair->members[0].con->width_fraction=pair->ratio;
+ pair->members[1].con->width_fraction=1-pair->ratio;
+ return true;
+}
+static void finish_parent(struct sway_lumen_pair *pair) {
+ struct sway_container *parent=pair->parent;
+ container_end_mouse_operation(parent);
