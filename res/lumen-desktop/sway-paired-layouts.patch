+}
+struct dialog_search { struct sway_container *owner; list_t *dialogs; bool any; };
+static void collect_dialogs(struct sway_container *con,void *data) {
+ struct dialog_search *search=data;
+ if(con==search->owner || !con->view || con->node.destroying)return;
+ if(con->lumen_pair_dialog_owner==search->owner->node.id){
+  if(search->dialogs)list_add(search->dialogs,con);
+ } else if(search->owner->view && view_is_transient_for(con->view,search->owner->view))search->any=true;
+}
+static bool owns_untagged_dialog(struct sway_container *con) {
+ struct dialog_search search={.owner=con};root_for_each_container(collect_dialogs,&search);return search.any;
+}
+static int moving_dialogs;
+static void follow_dialogs(struct sway_container *owner,struct sway_workspace *target,bool orphan) {
+ if(moving_dialogs || !target || !owner->view)return;
+ struct dialog_search search={.owner=owner,.dialogs=create_list()};
+ root_for_each_container(collect_dialogs,&search);moving_dialogs++;changing++;
