+static void lumen_drag_state(struct sway_seat *seat, bool active) {
+	if (seat->lumen_drag_active == active) return;
+	seat->lumen_drag_active = active;
+	seat->lumen_drag_serial++;
+	json_object *event = json_object_new_object();
+	json_object_object_add(event, "kind", json_object_new_string("lumen-drag"));
+	json_object_object_add(event, "version", json_object_new_int(1));
+	json_object_object_add(event, "seat", json_object_new_string(seat->wlr_seat->name));
+	json_object_object_add(event, "active", json_object_new_boolean(active));
+	json_object_object_add(event, "serial", json_object_new_int64(seat->lumen_drag_serial));
+	ipc_event_tick(json_object_to_json_string_ext(event, JSON_C_TO_STRING_PLAIN));
+	json_object_put(event);
+}
+
+static void lumen_drag_drop(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct sway_drag *drag = wl_container_of(listener, drag, lumen_drop);
+	lumen_drag_state(drag->seat, false);
+}
+
