+struct cmd_results *cmd_lumen_window(int argc, char **argv) {
+ struct cmd_results *error = checkarg(argc, "lumen_window", EXPECTED_EQUAL_TO, 1);
+ if (error) return error;
+ struct sway_container *con = config->handler_context.container;
+ if (!con || !con->view) return cmd_results_new(CMD_INVALID, "Select an application window");
+ if (strcmp(argv[0], "close") == 0) view_close(con->view);
+ else if (strcmp(argv[0], "minimize") == 0) container_lumen_minimize(con);
+ else if (strcmp(argv[0], "fill") == 0) container_lumen_fill(con);
+ else if (strcmp(argv[0], "fullscreen") == 0) container_set_fullscreen(con,
+  con->pending.fullscreen_mode == FULLSCREEN_NONE ? FULLSCREEN_WORKSPACE : FULLSCREEN_NONE);
+ else return cmd_results_new(CMD_INVALID, "Expected close, minimize, fill or fullscreen");
+ transaction_commit_dirty();
+ return cmd_results_new(CMD_SUCCESS, NULL);
