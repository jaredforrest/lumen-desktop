  *target = 0;
+ if (lumen_projection_off_origin(e->con)) return NULL;
  struct sway_cursor *cursor = e->seat->cursor;
@@ -147,2 +149,12 @@ static void update_target(struct seatop_move_floating_event *e) {
 
+static void pointer_move_to(struct sway_container *con, double lx, double ly) {
+ if (!con->lumen_projection_enabled || !con->pending.workspace) {
+  container_floating_move_to(con, lx, ly); return;
+ }
+ /* Pointer geometry changes do not imply a same-output desktop reassignment.
+  * Crossing outputs remains an explicit owning-output move. */
+ container_floating_translate(con, lx - con->pending.x, ly - con->pending.y);
+ if (container_floating_find_output(con) != con->pending.workspace->output)
+  container_floating_move_to(con, con->pending.x, con->pending.y);
+}
 static void finalize_move(struct sway_seat *seat) {
