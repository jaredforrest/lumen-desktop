- if (p) { free(p->workspace); free(p); }
-}
+ if (p) { free(p->workspace); free(p->output_name); free(p); }
+}
+
+bool container_lumen_rehome(struct sway_container *con, const char *source, const char *target, const char *output) {
+ if (!con || !con->view || !output_by_name_or_id(output)) return false;
+ struct sway_lumen_placement *all[] = {con->lumen_minimized, con->lumen_filled, con->lumen_hidden, con->lumen_desktop_hidden};
+ struct sway_lumen_placement *placements[4] = {0};
+ char *names[4] = {0}, *outputs[4] = {0};
+ int count = 0;
+ for (int i = 0; i < 4; i++) {
+  if (!all[i] || strcmp(all[i]->workspace, source) != 0) continue;
+  bool duplicate = false;
+  for (int j = 0; j < count; j++) if (placements[j] == all[i]) duplicate = true;
+  if (duplicate) continue;
+  placements[count] = all[i];
+  names[count] = strdup(target); outputs[count] = strdup(output);
+  if (!names[count] || !outputs[count]) {
+   for (int j = 0; j <= count; j++) {free(names[j]); free(outputs[j]);}
+   return false;
+  }
+  count++;
+ }
+ for (int i = 0; i < count; i++) {
+  free(placements[i]->workspace); free(placements[i]->output_name);
+  placements[i]->workspace = names[i]; placements[i]->output_name = outputs[i];
+  placements[i]->parent_id = 0; placements[i]->index = 0;
+ }
+ node_set_dirty(&con->node);
+ return true;
+}
