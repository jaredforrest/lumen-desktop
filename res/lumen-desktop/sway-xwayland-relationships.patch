+static bool lumen_relationship_one(struct sway_view *view,
+		struct sway_view **parent, int *modal) {
+	*parent = NULL;
+	*modal = -1;
+	if (!view || !view->surface || !view->surface->mapped ||
+			(view->container && view->container->node.destroying)) return false;
+	if (view->type == SWAY_VIEW_XDG_SHELL) {
+		struct wlr_xdg_toplevel *top = view->wlr_xdg_toplevel;
+		if (!top) return false;
+		if (top->parent) *parent = view_from_wlr_xdg_surface(top->parent->base);
+		struct wlr_xdg_dialog_v1 *dialog = wlr_xdg_dialog_v1_try_from_wlr_xdg_toplevel(top);
+		if (dialog) *modal = dialog->modal;
+		if (top->parent && !*parent) return false;
+	} else {
+#if WLR_HAS_XWAYLAND
+		if (view->type != SWAY_VIEW_XWAYLAND) return false;
+		struct wlr_xwayland_surface *surface = view->wlr_xwayland_surface;
+		// wlroots obtains this PID from XRes, never the client _NET_WM_PID hint.
+		if (!surface || surface->pid <= 0) return false;
+		*modal = surface->modal;
+		if (surface->parent) {
+			if (surface->parent->pid != surface->pid) return false;
+			*parent = view_from_wlr_xwayland_surface(surface->parent);
+			if (!*parent) return false;
+		}
+#else
+		return false;
+#endif
+	}
+	if (*parent && (!(*parent)->surface || !(*parent)->surface->mapped ||
+			!(*parent)->container || (*parent)->container->node.destroying)) return false;
+	return true;
+}
+
+bool lumen_view_relationship(struct sway_view *view,
+		struct sway_view **parent, int *modal) {
+	struct sway_view *seen[64], *current = view, *next = NULL;
+	int ignored = -1;
+	size_t count = 0;
+	while (current) {
+		if (count == 64) return false;
+		for (size_t i = 0; i < count; ++i) if (seen[i] == current) return false;
+		seen[count++] = current;
+		if (!lumen_relationship_one(current, &next, &ignored)) return false;
+		current = next;
+	}
+	return lumen_relationship_one(view, parent, modal);
+}
+
+bool lumen_view_transient_for(struct sway_view *view, struct sway_view *ancestor) {
+	struct sway_view *parent = NULL;
+	int modal;
+	for (size_t depth = 0; depth < 64; ++depth) {
+		if (!lumen_view_relationship(view, &parent, &modal) || !parent) return false;
+		if (parent == ancestor) return true;
+		view = parent;
+	}
+	return false;
+}
+
+void lumen_view_relationship_changed(struct sway_view *view) {
+	if (!view || !view->surface || !view->container || view->container->node.destroying) return;
+	if (view->container->pending.workspace) arrange_workspace(view->container->pending.workspace);
+	ipc_event_window(view->container, "lumen_relationships");
+	struct sway_seat *seat;
+	wl_list_for_each(seat, &server.input->seats, link) {
+		struct sway_node *focus = seat_get_focus(seat);
+		if (focus) seat_set_focus(seat, focus);
+	}
+}
+
