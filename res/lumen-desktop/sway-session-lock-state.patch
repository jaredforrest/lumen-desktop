@@ -11,4 +11,20 @@
 #include "sway/server.h"
 #include "sway/lock.h"
+#include "sway/ipc-server.h"
+
+static uint64_t lock_state_revision;
+static void lock_state_changed(void) {
+ lock_state_revision++;
+ /* A wakeup is never an authority claim: consumers query the native facts. */
+ ipc_event_tick("lumen-session-lock");
+}
+json_object *session_lock_state_json(void) {
+ json_object *state=json_object_new_object();
+ json_object_object_add(state,"version",json_object_new_int(1));
+ json_object_object_add(state,"available",json_object_new_boolean(server.session_lock.manager!=NULL));
+ json_object_object_add(state,"locked",json_object_new_boolean(server.session_lock.lock!=NULL));
+ json_object_object_add(state,"revision",json_object_new_int64(lock_state_revision));
+ return state;
+}
 
 struct sway_session_lock_output {
