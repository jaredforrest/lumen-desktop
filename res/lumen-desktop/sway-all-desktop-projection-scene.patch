+static void arrange_projection(struct sway_container *con, void *data) {
+ (void)data;
+ if (!lumen_projection_reserved(con) || !con->current.workspace ||
+     con->current.workspace != con->pending.workspace) return;
+ /* Preserve the one native scene/container identity. Reparenting to the same
+  * parent is a no-op: ordinary transactions must not raise projected views. */
+ wlr_scene_node_reparent(&con->scene_tree->node, root->layers.floating);
+ arrange_container(con, con->current.width, con->current.height, true,
+  container_get_gaps(con));
+ wlr_scene_node_set_position(&con->scene_tree->node, con->current.x, con->current.y);
+ wlr_scene_node_set_enabled(&con->scene_tree->node,
+  lumen_projection_presented(con) && view_is_visible(con->view));
