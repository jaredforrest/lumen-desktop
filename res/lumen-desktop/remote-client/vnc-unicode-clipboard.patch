+typedef struct {
+	GWeakRef connection;
+	const gchar *message;
+	gchar *rejected_hash;
+	gint generation;
+} RemminaVncClipboardWarning;
+
+static void remmina_plugin_vnc_clipboard_warning_destroy(GtkWidget *dialog, gpointer data)
+{
+	RemminaVncClipboardWarning *warning = data;
+	GObject *connection = g_weak_ref_get(&warning->connection);
+	if (connection) {
+		RemminaPluginVncData *gpdata = GET_PLUGIN_DATA(connection);
+		if (gpdata->clipboard_warning_dialog == dialog) gpdata->clipboard_warning_dialog = NULL;
+		if (g_atomic_int_get(&gpdata->clipboard_generation) == warning->generation)
+			g_atomic_int_set(&gpdata->clipboard_warning_pending, 0);
+		g_object_unref(connection);
+	}
+	g_weak_ref_clear(&warning->connection);
+	g_free(warning->rejected_hash);
+	g_free(warning);
+}
+
+static void remmina_plugin_vnc_clipboard_warning_response(GtkDialog *dialog, gint response, gpointer data)
+{
+	gtk_widget_destroy(GTK_WIDGET(dialog));
+}
+
+static gboolean remmina_plugin_vnc_clipboard_warning(gpointer data)
+{
+	RemminaVncClipboardWarning *warning = data;
+	GtkWidget *connection = g_weak_ref_get(&warning->connection);
+	REMMINA_PLUGIN_DEBUG("VNC clipboard warning dispatched; originating connection present: %d", connection != NULL);
+	if (connection && !gtk_widget_in_destruction(connection)) {
+		RemminaPluginVncData *gpdata = GET_PLUGIN_DATA(connection);
+		if (!gpdata->connected || !gpdata->client ||
+		    g_atomic_int_get(&gpdata->clipboard_generation) != warning->generation) {
+			g_object_unref(connection);
+			remmina_plugin_vnc_clipboard_warning_destroy(NULL, warning);
+			return FALSE;
+		}
+		if (warning->rejected_hash) {
+			RemminaPluginVncData *gpdata = GET_PLUGIN_DATA(connection);
+			g_free(gpdata->clipboard_rejected_hash);
+			gpdata->clipboard_rejected_hash = g_strdup(warning->rejected_hash);
+		}
+		GtkWidget *parent = gtk_widget_get_toplevel(connection);
+		REMMINA_PLUGIN_DEBUG("VNC clipboard warning originating toplevel live: %d", GTK_IS_WINDOW(parent) && gtk_widget_get_realized(parent) && !gtk_widget_in_destruction(parent));
+		if (GTK_IS_WINDOW(parent) && gtk_widget_get_realized(parent) && !gtk_widget_in_destruction(parent)) {
+			GtkWidget *dialog = gtk_message_dialog_new(GTK_WINDOW(parent), GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT, GTK_MESSAGE_WARNING, GTK_BUTTONS_CLOSE, "%s", warning->message);
+			gpdata->clipboard_warning_dialog = dialog;
+			gtk_window_set_title(GTK_WINDOW(dialog), _("Clipboard transfer"));
+			g_signal_connect(dialog, "response", G_CALLBACK(remmina_plugin_vnc_clipboard_warning_response), NULL);
+			g_signal_connect(dialog, "destroy", G_CALLBACK(remmina_plugin_vnc_clipboard_warning_destroy), warning);
+			g_signal_connect_object(connection, "destroy", G_CALLBACK(gtk_widget_destroy), dialog, G_CONNECT_SWAPPED);
+			gtk_widget_show(dialog);
+			g_object_unref(connection);
+			return FALSE;
+		}
+	}
+	if (connection) g_object_unref(connection);
+	remmina_plugin_vnc_clipboard_warning_destroy(NULL, warning);
+	return FALSE;
+}
+
+static void remmina_plugin_vnc_queue_clipboard_warning_for_text(RemminaProtocolWidget *gp, const gchar *message, const gchar *rejected_text)
+{
+	RemminaPluginVncData *gpdata = GET_PLUGIN_DATA(gp);
+	gint generation = g_atomic_int_get(&gpdata->clipboard_generation);
+	if (!g_atomic_int_compare_and_exchange(&gpdata->clipboard_warning_pending, 0, 1)) return;
+	REMMINA_PLUGIN_DEBUG("VNC clipboard warning queued for originating connection");
+	RemminaVncClipboardWarning *warning = g_new(RemminaVncClipboardWarning, 1);
+	g_weak_ref_init(&warning->connection, G_OBJECT(gp));
+	warning->message = message;
+	warning->generation = generation;
+	warning->rejected_hash = rejected_text ? g_compute_checksum_for_string(G_CHECKSUM_SHA256, rejected_text, -1) : NULL;
+	IDLE_ADD(remmina_plugin_vnc_clipboard_warning, warning);
+}
+
+static void remmina_plugin_vnc_queue_clipboard_warning(RemminaProtocolWidget *gp, const gchar *message)
+{
+	remmina_plugin_vnc_queue_clipboard_warning_for_text(gp, message, NULL);
+}
+
+static void remmina_plugin_vnc_invalidate_clipboard(RemminaProtocolWidget *gp)
+{
+	RemminaPluginVncData *gpdata = GET_PLUGIN_DATA(gp);
+	gpdata->connected = FALSE;
+	if (!gpdata->clipboard_generation_active) return;
+	gpdata->clipboard_generation_active = FALSE;
+	g_atomic_int_inc(&gpdata->clipboard_generation);
+	g_atomic_int_set(&gpdata->clipboard_warning_pending, 0);
+	REMMINA_PLUGIN_DEBUG("VNC clipboard generation invalidated: %d", g_atomic_int_get(&gpdata->clipboard_generation));
+	if (gpdata->clipboard_warning_dialog) gtk_widget_destroy(gpdata->clipboard_warning_dialog);
+}
+
+typedef struct {
+	GWeakRef connection;
+	gint generation;
+} RemminaVncConnectionClosure;
+
+static gboolean remmina_plugin_vnc_finish_connection_closed(gpointer data)
+{
+	RemminaVncConnectionClosure *closure = data;
+	RemminaProtocolWidget *gp = g_weak_ref_get(&closure->connection);
+	if (gp) {
+		RemminaPluginVncData *gpdata = GET_PLUGIN_DATA(gp);
+		if (!gtk_widget_in_destruction(GTK_WIDGET(gp)) && gpdata->clipboard_generation_active &&
+		    g_atomic_int_get(&gpdata->clipboard_generation) == closure->generation) {
+			remmina_plugin_vnc_invalidate_clipboard(gp);
+			remmina_plugin_service->protocol_plugin_signal_connection_closed(gp);
+		}
+		g_object_unref(gp);
+	}
+	g_weak_ref_clear(&closure->connection);
+	g_free(closure);
+	return FALSE;
+}
+
+static void remmina_plugin_vnc_queue_connection_closed(RemminaProtocolWidget *gp)
+{
+	RemminaPluginVncData *gpdata = GET_PLUGIN_DATA(gp);
+	RemminaVncConnectionClosure *closure = g_new(RemminaVncConnectionClosure, 1);
+	closure->generation = g_atomic_int_get(&gpdata->clipboard_generation);
+	g_weak_ref_init(&closure->connection, G_OBJECT(gp));
+	IDLE_ADD(remmina_plugin_vnc_finish_connection_closed, closure);
+}
