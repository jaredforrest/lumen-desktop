+typedef struct {
+	GWeakRef connection;
+	const gchar *message;
+} RemminaVncClipboardWarning;
+
+static gboolean remmina_plugin_vnc_clipboard_warning(gpointer data)
+{
+	RemminaVncClipboardWarning *warning = data;
+	GtkWidget *connection = g_weak_ref_get(&warning->connection);
+	if (connection && !gtk_widget_in_destruction(connection)) {
+		GtkWidget *parent = gtk_widget_get_toplevel(connection);
+		if (GTK_IS_WINDOW(parent) && gtk_widget_get_realized(parent) && !gtk_widget_in_destruction(parent)) {
+			GtkWidget *dialog = gtk_message_dialog_new(GTK_WINDOW(parent), GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT, GTK_MESSAGE_WARNING, GTK_BUTTONS_CLOSE, "%s", warning->message);
+			g_object_ref_sink(dialog);
+			gtk_window_set_title(GTK_WINDOW(dialog), _("Clipboard transfer"));
+			gtk_dialog_run(GTK_DIALOG(dialog));
+			gtk_widget_destroy(dialog);
+			g_object_unref(dialog);
+		}
+	}
+	if (connection) g_object_unref(connection);
+	g_weak_ref_clear(&warning->connection);
+	g_free(warning);
+	return FALSE;
+}
+
+static void remmina_plugin_vnc_queue_clipboard_warning(RemminaProtocolWidget *gp, const gchar *message)
+{
+	RemminaVncClipboardWarning *warning = g_new(RemminaVncClipboardWarning, 1);
+	g_weak_ref_init(&warning->connection, G_OBJECT(gp));
+	warning->message = message;
+	IDLE_ADD(remmina_plugin_vnc_clipboard_warning, warning);
+}
