+
+void container_lumen_placement_free(struct sway_lumen_placement *p) {
+ if (p) { free(p->workspace); free(p); }
+}
+
+bool container_lumen_action_enabled(struct sway_container *con, int action) {
+ if (!con || con->node.destroying || !con->view || !con->view->surface) return false;
+ if (action == 0) return true;
+ const char *app = view_get_app_id(con->view);
+ if (app && strcmp(app, "org.quickshell") == 0 && con->title) {
+  if (strcmp(con->title, "Window Overview") == 0 || strcmp(con->title, "Quick Look") == 0) return false;
+  if (action == 2 && strcmp(con->title, "Text Tools") == 0) return false;
+ }
+ return true;
+}
+
+static struct sway_lumen_placement *lumen_save(struct sway_container *con) {
+ if (!con->pending.workspace) return NULL;
+ struct sway_lumen_placement *p = calloc(1, sizeof(*p));
+ if (!p) return NULL;
+ p->workspace = strdup(con->pending.workspace->name);
+ if (!p->workspace) { free(p); return NULL; }
+ p->parent_id = con->pending.parent ? con->pending.parent->node.id : 0;
+ p->index = list_find(container_get_siblings(con), con);
+ p->floating = container_is_floating(con);
+ p->box = (struct wlr_box){con->pending.x, con->pending.y, con->pending.width, con->pending.height};
+ p->fullscreen = con->pending.fullscreen_mode;
+ if (p->fullscreen != FULLSCREEN_NONE) p->box = (struct wlr_box){con->saved_x, con->saved_y, con->saved_width, con->saved_height};
+ p->border = con->pending.border;
+ p->width_fraction = con->width_fraction; p->height_fraction = con->height_fraction;
+ return p;
+}
+
+static bool lumen_parent_matches(struct sway_container *con, void *data) {
+ return con->node.id == *(uint64_t *)data && !con->node.destroying && !con->view;
+}
+
+static void lumen_restore(struct sway_container *con, struct sway_lumen_placement *p, bool focus) {
+ struct sway_workspace *ws = workspace_by_name(p->workspace);
+ if (!ws) {
+  struct sway_workspace *focused = seat_get_focused_workspace(input_manager_current_seat());
+  if (!focused) return;
+  ws = workspace_create(focused->output, p->workspace);
+ }
+ if (ws->width <= 0 || ws->height <= 0) arrange_workspace(ws);
+ struct sway_container *parent = p->parent_id ? root_find_container(lumen_parent_matches, &p->parent_id) : NULL;
+ if (parent && parent->pending.workspace != ws) parent = NULL;
+ if (con->scratchpad) root_scratchpad_remove_container(con);
+ container_detach(con);
+ workspace_add_floating(ws, con);
+ if (!p->floating) {
+  container_set_floating(con, false);
+  container_detach(con);
+  list_t *siblings = parent ? parent->pending.children : ws->tiling;
+  int index = p->index < 0 ? 0 : p->index > siblings->length ? siblings->length : p->index;
+  if (parent) container_insert_child(parent, con, index);
+  else workspace_insert_tiling_direct(ws, con, index);
+  double width = parent ? parent->pending.width : ws->width;
+  double height = parent ? parent->pending.height : ws->height;
+  double wf = width > 0 ? p->box.width / width : p->width_fraction;
+  double hf = height > 0 ? p->box.height / height : p->height_fraction;
+  if (wf > 1) wf = 1;
+  if (hf > 1) hf = 1;
+  double totalw = 0, totalh = 0;
+  for (int i = 0; i < siblings->length; i++) {
+   struct sway_container *other = siblings->items[i];
+   if (other != con) { totalw += other->width_fraction; totalh += other->height_fraction; }
+  }
+  for (int i = 0; i < siblings->length; i++) {
+   struct sway_container *other = siblings->items[i];
+   if (other != con) {
+    if (totalw > 0) other->width_fraction *= (1-wf) / totalw;
+    if (totalh > 0) other->height_fraction *= (1-hf) / totalh;
+   }
+  }
+  con->width_fraction = wf; con->height_fraction = hf;
+ }
+ con->pending.x = p->box.x; con->pending.y = p->box.y;
+ con->pending.width = p->box.width; con->pending.height = p->box.height;
+ con->pending.border = p->border;
+ if (p->floating) {
+  // Restore onto the surviving work area when an output was removed or resized.
+  if (con->pending.width > ws->width) con->pending.width = ws->width;
+  if (con->pending.height > ws->height) con->pending.height = ws->height;
+  if (con->pending.x < ws->x) con->pending.x = ws->x;
+  if (con->pending.y < ws->y) con->pending.y = ws->y;
+  if (con->pending.x + con->pending.width > ws->x + ws->width) con->pending.x = ws->x + ws->width - con->pending.width;
+  if (con->pending.y + con->pending.height > ws->y + ws->height) con->pending.y = ws->y + ws->height - con->pending.height;
+ }
+ arrange_workspace(ws);
+ node_set_dirty(&con->node);
+ if (con->view && con->view->foreign_toplevel) wlr_foreign_toplevel_handle_v1_set_minimized(con->view->foreign_toplevel, false);
+ if (p->fullscreen != FULLSCREEN_NONE) container_set_fullscreen(con, p->fullscreen);
+ if (focus) seat_set_focus(input_manager_current_seat(), &con->node);
+}
+
+static bool lumen_desktop_revealed;
+static uint64_t lumen_desktop_focus;
+
+static void lumen_desktop_collect(struct sway_container *con, void *data) {
+ list_t *targets = data;
+ if (!con->view || con->node.destroying) return;
+ if (lumen_desktop_revealed) {
+  if (con->lumen_desktop_hidden) list_add(targets, con);
+ } else if (!con->scratchpad && con->pending.workspace && workspace_is_visible(con->pending.workspace)) {
+  list_add(targets, con);
+ }
+}
+
+static bool lumen_desktop_focus_matches(struct sway_container *con, void *data) {
+ return con->node.id == *(uint64_t *)data && con->view && !con->node.destroying;
+}
+
+void container_lumen_show_desktop(int mode) {
+ bool show = mode < 0 ? !lumen_desktop_revealed : mode != 0;
+ if (show == lumen_desktop_revealed) return;
+ list_t *targets = create_list();
+ if (!targets) return;
+ root_for_each_container(lumen_desktop_collect, targets);
+ struct sway_seat *seat = input_manager_current_seat();
+ if (show) {
+  struct sway_container *focused = seat_get_focused_container(seat);
+  lumen_desktop_focus = focused ? focused->node.id : 0;
+ }
+ for (int i = 0; i < targets->length; ++i) {
+  struct sway_container *con = targets->items[i];
+  if (show) {
+   con->lumen_desktop_hidden = lumen_save(con);
+   if (con->lumen_desktop_hidden) root_scratchpad_add_container(con, NULL);
+  } else {
+   struct sway_lumen_placement *saved = con->lumen_desktop_hidden;
+   con->lumen_desktop_hidden = NULL;
+   lumen_restore(con, saved, false);
+   container_lumen_placement_free(saved);
+  }
+  node_set_dirty(&con->node);
+ }
+ list_free(targets);
+ lumen_desktop_revealed = show;
+ if (!show) {
+  struct sway_container *focused = root_find_container(lumen_desktop_focus_matches, &lumen_desktop_focus);
+  if (focused && !focused->scratchpad) seat_set_focus(seat, &focused->node);
+  lumen_desktop_focus = 0;
+ }
+}
+
+void container_lumen_hide(struct sway_container *con) {
+ if (!container_lumen_action_enabled(con, 0) || con->lumen_app_hidden) return;
+ if (!con->scratchpad) {
+  con->lumen_hidden = lumen_save(con);
+  if (!con->lumen_hidden) return;
+  root_scratchpad_add_container(con, NULL);
+ }
