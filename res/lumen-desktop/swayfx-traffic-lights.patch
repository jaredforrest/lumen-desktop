+void container_lumen_restore(struct sway_container *con) {
+ if (!con || !con->lumen_filled) return;
+ struct sway_lumen_placement *p = con->lumen_filled;
+ con->lumen_filled = NULL;
+ if (con->pending.fullscreen_mode != FULLSCREEN_NONE) container_fullscreen_disable(con);
+ lumen_restore(con, p, true);
