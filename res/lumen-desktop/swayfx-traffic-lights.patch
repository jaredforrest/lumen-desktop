+ else if (strcmp(argv[0], "top") == 0) container_lumen_tile(con, 0, 0, 1, 2);
+ else if (strcmp(argv[0], "bottom") == 0) container_lumen_tile(con, 0, 1, 1, 2);
+ else if (strcmp(argv[0], "top-left") == 0) container_lumen_tile(con, 0, 0, 2, 2);
+ else if (strcmp(argv[0], "top-right") == 0) container_lumen_tile(con, 1, 0, 2, 2);
+ else if (strcmp(argv[0], "bottom-left") == 0) container_lumen_tile(con, 0, 1, 2, 2);
+ else if (strcmp(argv[0], "bottom-right") == 0) container_lumen_tile(con, 1, 1, 2, 2);
+ else if (strcmp(argv[0], "fullscreen") == 0) container_set_fullscreen(con,
