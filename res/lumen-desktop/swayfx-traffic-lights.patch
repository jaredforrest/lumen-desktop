+}
+
+void container_lumen_tile(struct sway_container *con, int column, int row, int columns, int rows) {
+ if (!container_lumen_action_enabled(con, 2) || !con->pending.workspace || con->scratchpad) return;
+ if (columns < 1 || rows < 1 || column < 0 || row < 0 || column >= columns || row >= rows) return;
+ if (con->pending.fullscreen_mode != FULLSCREEN_NONE) container_fullscreen_disable(con);
+ if (!con->lumen_filled) con->lumen_filled = lumen_save(con);
