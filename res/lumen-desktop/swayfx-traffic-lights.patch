+ if (!con->lumen_filled) return;
+ struct sway_workspace *ws = con->pending.workspace;
+ container_set_floating(con, true);
+ con->pending.border = con->lumen_filled->border;
+ con->pending.x = ws->x; con->pending.y = ws->y;
+ con->pending.width = ws->width; con->pending.height = ws->height;
+ arrange_workspace(ws); node_set_dirty(&con->node);
+}
