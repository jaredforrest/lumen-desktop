+ if (strcmp(setting, "titlebar-action") == 0) {
+  if (strcmp(value, "none") == 0) lumen_titlebar_action = 0;
+  else if (strcmp(value, "fill") == 0) lumen_titlebar_action = 1;
+  else if (strcmp(value, "minimize") == 0) lumen_titlebar_action = 2;
