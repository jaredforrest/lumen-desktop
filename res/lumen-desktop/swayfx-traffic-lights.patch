+ struct sway_container *con = config->handler_context.container;
+ if (!con || !con->view) return cmd_results_new(CMD_INVALID, "Select an application window");
+ if (strcmp(argv[0], "close") == 0) view_close(con->view);
+ else if (strcmp(argv[0], "hide") == 0) container_lumen_hide(con);
+ else if (strcmp(argv[0], "unhide") == 0) container_lumen_unhide(con);
+ else if (strcmp(argv[0], "minimize") == 0) container_lumen_minimize(con);
+ else if (strcmp(argv[0], "fill") == 0) container_lumen_fill(con);
+ else if (strcmp(argv[0], "restore") == 0) container_lumen_restore(con);
