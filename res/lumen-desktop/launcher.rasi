* {
    font: "Interlude Variable 13";
    background-color: transparent;
    text-color: #f5f5f7;
    border-color: #42444b;
}
window {
    width: 640px;
    location: center;
    anchor: center;
    background-color: #25272c;
    border: 1px;
    border-radius: 16px;
}
mainbox {
    padding: 18px;
    spacing: 14px;
    children: [ inputbar, message, listview ];
}
inputbar {
    padding: 12px 14px;
    spacing: 12px;
    background-color: #303238;
    border-radius: 10px;
    children: [ prompt, entry ];
}
prompt { text-color: #a1a1aa; }
entry {
    placeholder: "Search…";
    placeholder-color: #a1a1aa;
    cursor: text;
}
listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}
element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 9px;
}
element selected.normal, element selected.active {
    background-color: #37475e;
    text-color: #f5f5f7;
}
element urgent { text-color: #e6a16a; }
element selected.urgent { background-color: #403127; }
element-icon { size: 28px; }
element-text { vertical-align: 0.5; }
message { padding: 8px 12px; border-radius: 8px; background-color: #303238; }
error-message { padding: 18px; }
