* { font: "sans 12"; background-color: transparent; text-color: #f5f6fa; }
window { width: 360px; location: center; background-color: #24262c; border: 1px; border-color: #51545f; border-radius: 18px; }
mainbox { padding: 16px; spacing: 10px; children: [ inputbar, listview ]; }
inputbar { children: [ prompt ]; padding: 6px 10px; }
prompt { font: "sans Bold 15"; }
listview { fixed-height: false; lines: 5; spacing: 4px; scrollbar: false; }
element { padding: 10px 12px; border-radius: 10px; }
element selected.normal { background-color: #176dcc; }
element-text { vertical-align: 0.5; }
