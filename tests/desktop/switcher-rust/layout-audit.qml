    function layoutTextTree(object,seen){if(!object || seen.includes(object))return [];seen.push(object);let text=[];if(typeof object.text==="string" && object.visible!==false)text.push(object.text);for(const list of [object.children,object.data])if(list && typeof list.length==="number")for(let i=0;i<list.length;i++)text=text.concat(layoutTextTree(list[i],seen));if(object.contentItem)text=text.concat(layoutTextTree(object.contentItem,seen));return text;}
    function layoutKeycapsVisible(){const item=settingsWindow.findControl("shortcut-layout-observed-bindings",settingsWindow.contentItem);const viewport=settingsWindow.findControl("settings-content-scroll",settingsWindow.contentItem);if(!item || !viewport || !settingsWindow.visible || !item.visible)return false;const at=item.mapToItem(viewport.contentItem,0,0);return at.y>=viewport.contentY-1 && at.y+item.height<=viewport.contentY+viewport.height+1 && at.x>=-1 && at.x+item.width<=viewport.width+1;}
    IpcHandler {target:"layoutAudit"
        function open():void{root.openSettings("Accessibility");settingsWindow.navigate("Accessibility","configured-shortcuts");Qt.callLater(()=>{const item=settingsWindow.findControl("shortcut-layout-observed-bindings",settingsWindow.contentItem);if(item){item.forceActiveFocus();settingsWindow.revealFocus();}});}
        function close():void{settingsWindow.visible=false;}
        function status():string{return JSON.stringify({available:ShortcutLayoutState.available,generation:ShortcutLayoutState.generation,mode:ShortcutLayoutState.activeMode,error:ShortcutLayoutState.error,rows:ShortcutLayoutState.rows("fixture.plus"),keycaps:ShortcutLayoutState.keycaps("fixture.plus"),switchHint:root.shortcuts.hint("shell.app_switcher"),settings:settingsWindow.visible,keycapsVisible:root.layoutKeycapsVisible(),painted:root.layoutTextTree(settingsWindow,[]),picker:JSON.parse(applicationSwitcher.status()),active:root.active?root.active.title:""});}
