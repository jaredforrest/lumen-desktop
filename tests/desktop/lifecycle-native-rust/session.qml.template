import QtQuick
import Quickshell
import Quickshell.Io
import "__SHELL_URI__" as D
ShellRoot {
 id:audit
 property var transitions:[]
 function record(kind,detail){transitions=transitions.concat([{kind:kind,detail:detail,available:lifecycle.available,session:lifecycle.session,error:lifecycle.error}]).slice(-64);}
 D.ApplicationLifecycleState {id:lifecycle}
 Connections {target:lifecycle;function onAvailableChanged(){audit.record("availability","");}function onSessionChanged(){audit.record("session","");}}
 Connections {target:lifecycle.observer.stderr;function onStreamFinished(){audit.record("provider-stderr",lifecycle.observer.stderr.text.slice(0,1024));}}
 D.SessionOptions {id:options;lifecycle:lifecycle}
 IpcHandler {target:"sessionAudit"
  function begin():void{options.show("reboot");options.confirm();}
  function confirm():void{options.confirm();}
  function cancel():void{options.dismiss();}
  function status():string{return JSON.stringify({available:lifecycle.available,session:lifecycle.session,applications:lifecycle.applications,visible:options.visible,error:options.error,transitions:audit.transitions});}
 }
}
