name: Checks
on: [push, pull_request]
permissions:
  contents: read
defaults:
  run:
    shell: bash
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  contracts-and-units:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: cachix/install-nix-action@v31
      # Keep the software VM out of concurrent compiler memory/CPU contention.
      - run: nix flake check --print-build-logs --option abort-on-warn true --max-jobs 1 --cores 2
      - run: nix develop --command nu tests/ci/test_prepare_software_effects.nu
      - run: nix develop --command nu tests/ci/test_run_native.nu
  integration:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: cachix/install-nix-action@v31
      - run: nix develop --command gitleaks git . --redact=100
      - run: nix develop --command nu tests/ci/run-native.nu namespace_policy_prepare -- lumen-native-namespace-policy prepare --output artifacts/native-namespace-policy
      - run: nix develop --command nu tests/ci/integration-smoke.nu
      - run: nix develop --command nu tests/desktop/image_markup_qml.nu
      - run: nix develop --command nu tests/desktop/typography_roles.nu
      - run: nix develop --command nu tests/desktop/test_typography_cases.nu
      - run: nix develop --command nu tests/desktop/owned_typography_qml.nu
      - run: nix develop --command nu tests/desktop/owned_utility_typography_qml.nu
      - run: nix develop --command nu tests/desktop/document_tabs_typography.nu
      - run: nix develop --command nu tests/desktop/overview_typography_qml.nu
      - run: nix develop --command nu tests/desktop/calendar_detail_typography_qml.nu
      - run: nix develop --command nu tests/desktop/shared_control_typography_qml.nu
      - run: nix develop --command nu tests/desktop/launcher_typography_qml.nu
      - run: nix develop --command nu tests/desktop/network_health_presentation.nu
      - run: nix develop --command nu tests/desktop/display_spaces_model.nu
      - run: nix develop --command nu tests/desktop/display_spaces_wire.nu
      - run: nix develop --command nu tests/desktop/owned_focus.nu
      - run: nix develop --command nu tests/desktop/minimized_window_model.nu
      - run: nix develop --command nu tests/desktop/screen_saver_queue.nu
      - run: nix develop --command nu tests/desktop/folder_stack_model.nu
      - run: nix develop --command nu tests/desktop/desktop_navigation_model.nu
      - run: nix develop --command nu tests/desktop/captured_directory_qml.nu
      - run: nix develop --command nu tests/desktop/files_listing_checkpoint.nu
      - run: nix develop --command nu tests/desktop/dock_calendar_corpus.nu
      - run: nix develop --command nu tests/desktop/switch_indicator_paint.nu
      - run: nix develop --command nu tests/desktop/semantic_state_paint.nu
      - run: nix develop --command nu tests/ci/integration-effects.nu
      - run: nix develop --command nu tests/ci/integration-native.nu
      - run: nix develop --command nu tests/ci/integration-network.nu
      - if: always()
        run: nix develop --command nu tests/ci/run-native.nu namespace_policy_cleanup -- lumen-native-namespace-policy cleanup --output artifacts/native-namespace-policy
      - if: always()
        run: nix develop --command lumen-stage-artifacts . tests/ci/backend-artifact-paths.txt artifacts-upload/backend-logs
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        if: always()
        with:
          name: backend-logs
          if-no-files-found: error
          path: artifacts-upload/backend-logs

  vault-compatibility:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: cachix/install-nix-action@v31
      - run: |
          mkdir -p artifacts
          nix build .#test-vault-server -o artifacts/vault-server --option abort-on-warn true
          nix build .#test-vault-web -o artifacts/vault-web --option abort-on-warn true
          nix build .#test-vault-cli -o artifacts/vault-cli --option abort-on-warn true
          nix build .#test-vault-browser -o artifacts/vault-browser --option abort-on-warn true
          nix build .#test-vault-tools -o artifacts/vault-tools --option abort-on-warn true
          nix build .#test-owned-font-config -o artifacts/vault-fonts --option abort-on-warn true
          nix build .#test-browser-workflows-fixture -o artifacts/vault-fixture --option abort-on-warn true
      - run: nix develop --command nu tests/ci/run-native.nu vault_namespace_prepare -- lumen-native-namespace-policy prepare --output artifacts/vault-namespace
      - run: nix develop --command nu tests/ci/run-native.nu vault_transport_native -- "$PWD/artifacts/vault-fixture/bin/vault-transport-native" --tls-tool "$PWD/artifacts/vault-tools/bin/openssl" --output artifacts/vault-transport
      - run: nix develop --command nu tests/ci/run-native.nu vault_compatibility -- "$PWD/artifacts/vault-fixture/bin/disposable-vault" --server "$PWD/artifacts/vault-server/bin/vaultwarden" --web "$PWD/artifacts/vault-web/share/vaultwarden/vault" --cli "$PWD/artifacts/vault-cli/bin/bw" --browser "$PWD/artifacts/vault-browser/bin/brave" --bus "$PWD/artifacts/vault-tools/bin/dbus-daemon" --tls-tool "$PWD/artifacts/vault-tools/bin/openssl" --trust-tool "$PWD/artifacts/vault-tools/bin/certutil" --font-config "$PWD/artifacts/vault-fonts" --output artifacts/vault-compatibility
      - if: always()
        run: nix develop --command nu tests/ci/run-native.nu vault_namespace_cleanup -- lumen-native-namespace-policy cleanup --output artifacts/vault-namespace
      - if: always()
        run: nix develop --command lumen-stage-artifacts . tests/ci/vault-artifact-paths.txt artifacts-upload/vault-compatibility
      - if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: vault-compatibility
          if-no-files-found: error
          path: artifacts-upload/vault-compatibility

  provider-save-integrity:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: cachix/install-nix-action@v31
      - run: |
          mkdir -p artifacts
          nix build .#wordcraft --out-link artifacts/wordcraft --option abort-on-warn true
          nix build .#gridcraft --out-link artifacts/gridcraft --option abort-on-warn true
          nix build .#deckcraft --out-link artifacts/deckcraft --option abort-on-warn true
          nix build .#test-office-workflows-fixture --out-link artifacts/provider-integrity-fixture --option abort-on-warn true
          nix build .#test-office-tools --out-link artifacts/office-pdf-tools --option abort-on-warn true
          nix build .#test-application-isolation --out-link artifacts/application-isolation --option abort-on-warn true
          nix build .#compositor-basic --out-link artifacts/provider-compositor --option abort-on-warn true
          nix build .#compositor --out-link artifacts/provider-compositor-effects --option abort-on-warn true
          nix build .#test-physical-keyboard --out-link artifacts/provider-keyboard --option abort-on-warn true
          nix build .#test-pointer --out-link artifacts/provider-pointer --option abort-on-warn true
          nix build .#test-application-software-driver --out-link artifacts/provider-software-driver --option abort-on-warn true
          nix build .#test-office-dialog-tools --out-link artifacts/provider-dialog-tools --option abort-on-warn true
          nix build .#test-screen-reader-atspi --out-link artifacts/provider-atspi --option abort-on-warn true
      - run: nix develop --command nu tests/ci/prepare-software-effects.nu artifacts/provider-software-effects-kernel
      - run: nix develop --command nu tests/ci/run-native.nu provider_save_namespace_prepare -- lumen-native-namespace-policy prepare --output artifacts/provider-save-namespace
      - run: nix develop --command nu tests/ci/run-native.nu provider_save_integrity -- "$PWD/artifacts/provider-integrity-fixture/bin/provider-save-integrity" --wordcraft "$PWD/artifacts/wordcraft/bin/wordcraft-cli" --gridcraft "$PWD/artifacts/gridcraft/bin/gridcraft-cli" --deckcraft "$PWD/artifacts/deckcraft/bin/deckcraft-cli" --output artifacts/provider-save-integrity
      - run: PATH="$PWD/artifacts/application-isolation/bin:$PATH" nix develop --command nu tests/ci/run-native.nu document_capabilities -- "$PWD/artifacts/provider-integrity-fixture/bin/document-capabilities" --writer "$PWD/artifacts/wordcraft/bin/wordcraft-cli" --sheet "$PWD/artifacts/gridcraft/bin/gridcraft-cli" --slides "$PWD/artifacts/deckcraft/bin/deckcraft-cli" --pdf-tools "$PWD/artifacts/office-pdf-tools" --output artifacts/document-capabilities
      - run: PATH="$PWD/artifacts/application-isolation/bin:$PATH" nix develop --command nu tests/ci/run-native.nu word_durable_history -- "$PWD/artifacts/provider-integrity-fixture/bin/word-durable-history" --writer "$PWD/artifacts/wordcraft/bin/wordcraft-cli" --output artifacts/word-durable-history
      - run: PATH="$PWD/artifacts/application-isolation/bin:$PATH" nix develop --command nu tests/ci/run-native.nu word_history_capacity -- "$PWD/artifacts/provider-integrity-fixture/bin/word-durable-history" --capacity-probe --writer "$PWD/artifacts/wordcraft/bin/wordcraft-cli" --output artifacts/word-history-capacity
      - run: |
          for app in sheet slides; do
            provider=gridcraft
            if [[ "$app" == slides ]]; then provider=deckcraft; fi
            PATH="$PWD/artifacts/application-isolation/bin:$PATH" nix develop --command nu tests/ci/run-native.nu "provider_history_${app}" -- "$PWD/artifacts/provider-integrity-fixture/bin/provider-durable-history" --app "$app" --provider-cli "$PWD/artifacts/$provider/bin/$provider-cli" --output "artifacts/provider-history-$app"
          done
      - run: |
          for backend in basic effects; do
            compositor=provider-compositor
            flags=()
            if [[ "$backend" == effects ]]; then compositor=provider-compositor-effects; flags+=(--effects); fi
            nix develop --command nu tests/ci/run-native.nu "word_history_${backend}" -- "$PWD/artifacts/provider-integrity-fixture/bin/office-native-workflows" "${flags[@]}" --app writer --history-probe --writer "$PWD/artifacts/wordcraft/bin/wordcraft" --sheet "$PWD/artifacts/gridcraft/bin/gridcraft" --slides "$PWD/artifacts/deckcraft/bin/deckcraft" --sway "$PWD/artifacts/$compositor/bin/sway" --keyboard-tool "$PWD/artifacts/provider-keyboard/bin/lumen-test-physical-keyboard" --pointer-tool "$PWD/artifacts/provider-pointer/bin/wlrctl" --software-driver "$PWD/artifacts/provider-software-driver" --dialog-tools "$PWD/artifacts/provider-dialog-tools" --at-spi-prefix "$PWD/artifacts/provider-atspi" --output "artifacts/word-history-$backend"
            for app in sheet slides; do
              nix develop --command nu tests/ci/run-native.nu "provider_history_${app}_${backend}" -- "$PWD/artifacts/provider-integrity-fixture/bin/office-native-workflows" "${flags[@]}" --app "$app" --history-probe --writer "$PWD/artifacts/wordcraft/bin/wordcraft" --sheet "$PWD/artifacts/gridcraft/bin/gridcraft" --slides "$PWD/artifacts/deckcraft/bin/deckcraft" --sway "$PWD/artifacts/$compositor/bin/sway" --keyboard-tool "$PWD/artifacts/provider-keyboard/bin/lumen-test-physical-keyboard" --pointer-tool "$PWD/artifacts/provider-pointer/bin/wlrctl" --software-driver "$PWD/artifacts/provider-software-driver" --dialog-tools "$PWD/artifacts/provider-dialog-tools" --at-spi-prefix "$PWD/artifacts/provider-atspi" --output "artifacts/provider-history-$app-$backend"
            done
            for format in docx odt; do
              nix develop --command nu tests/ci/run-native.nu "provider_copy_${backend}_${format}" -- "$PWD/artifacts/provider-integrity-fixture/bin/office-native-workflows" "${flags[@]}" --app writer --copy-export-probe --copy-export-format "$format" --writer "$PWD/artifacts/wordcraft/bin/wordcraft" --sheet "$PWD/artifacts/gridcraft/bin/gridcraft" --slides "$PWD/artifacts/deckcraft/bin/deckcraft" --sway "$PWD/artifacts/$compositor/bin/sway" --keyboard-tool "$PWD/artifacts/provider-keyboard/bin/lumen-test-physical-keyboard" --pointer-tool "$PWD/artifacts/provider-pointer/bin/wlrctl" --software-driver "$PWD/artifacts/provider-software-driver" --dialog-tools "$PWD/artifacts/provider-dialog-tools" --at-spi-prefix "$PWD/artifacts/provider-atspi" --output "artifacts/provider-copy-$backend-$format"
            done
          done
      - if: always()
        run: nix develop --command nu tests/ci/run-native.nu provider_save_namespace_cleanup -- lumen-native-namespace-policy cleanup --output artifacts/provider-save-namespace
      - if: always()
        run: nix develop --command lumen-stage-artifacts . tests/ci/provider-artifact-paths.txt artifacts-upload/provider-save-integrity
      - if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: provider-save-integrity
          if-no-files-found: error
          path: artifacts-upload/provider-save-integrity
